// Lucide icons (ISC, assets/icons/LICENSE), as in rimelight-space, plus a few drawn for this app in the same style.
// Icons are monochrome: tint them with `colorize`.
export global Icons {
    out property <image> logo: @image-url("../assets/icons/logo-color.svg");
    // The app's own icon (the .exe and shortcut icon), as a PNG exported from assets/rimelight-media.ico.
    out property <image> app-icon: @image-url("../assets/rimelight-media.png");
    out property <image> play: @image-url("../assets/icons/play.svg");
