// "New canvas": the size (window, 1920 x 1080, A4 at 150 dpi, or custom) and the background (white or transparent).
import { LineEdit } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Button, ButtonKind } from "widgets.slint";
import { Shell } from "state.slint";

export component NewCanvasDialog inherits Rectangle {
    // 0 window size, 1 1920 x 1080, 2 A4 at 150 dpi (1240 x 1754), 3 custom.
    in-out property <int> preset: 1;
    in-out property <string> custom-w: "1280";
    in-out property <string> custom-h: "720";
    in-out property <bool> transparent: false;

    background: Tokens.scrim;
    // Swallows the clicks that would reach the page behind.
    TouchArea { }

    Rectangle {
        width: min(460px, parent.width - 2 * Tokens.space-6);
        height: layout.preferred-height + 2 * Tokens.space-5;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Tokens.surface-overlay;
        border-radius: Tokens.radius-r8;
        border-width: 1px;
        border-color: Tokens.border-subtle;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;

        layout := VerticalLayout {
            padding: Tokens.space-5;
            spacing: Tokens.space-3;
            alignment: start;
            Text { text: "New canvas"; color: Tokens.text-primary; font-size: Type.heading; font-weight: 600; }
            Text { text: "Size"; color: Tokens.text-muted; font-size: Type.caption; }
            HorizontalLayout {
                spacing: Tokens.space-2;
                Button { text: "Window size"; kind: root.preset == 0 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { root.preset = 0; } }
                Button { text: "1920 x 1080"; kind: root.preset == 1 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { root.preset = 1; } }
                Button { text: "A4 at 150 dpi"; kind: root.preset == 2 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { root.preset = 2; } }
                Button { text: "Custom"; kind: root.preset == 3 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { root.preset = 3; } }
            }
            if root.preset == 3: HorizontalLayout {
                spacing: Tokens.space-2;
                LineEdit { width: 100px; text <=> root.custom-w; input-type: number; }
                Text { text: "×"; color: Tokens.text-muted; vertical-alignment: center; }
                LineEdit { width: 100px; text <=> root.custom-h; input-type: number; }
                Text { text: "pixels"; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; }
            }
            Text { text: "Background"; color: Tokens.text-muted; font-size: Type.caption; }
            HorizontalLayout {
                spacing: Tokens.space-2;
                Button { text: "White"; kind: root.transparent ? ButtonKind.ghost : ButtonKind.secondary; clicked => { root.transparent = false; } }
                Button { text: "Transparent"; kind: root.transparent ? ButtonKind.secondary : ButtonKind.ghost; clicked => { root.transparent = true; } }
            }
            Rectangle { height: Tokens.space-2; }
            HorizontalLayout {
                alignment: end;
                spacing: Tokens.space-2;
                Button { text: "Cancel"; kind: ButtonKind.ghost; clicked => { Shell.canvas-popup-open = false; } }
                Button {
                    text: "Create";
                    kind: ButtonKind.primary;
                    clicked => {
                        Shell.canvas-popup-open = false;
                        Shell.new-canvas(root.preset, root.custom-w, root.custom-h, root.transparent);
                    }
                }
            }
        }
    }
}
