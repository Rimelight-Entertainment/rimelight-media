// The state Rust drives, as globals so every page reads it without passing properties down.
import { Choice } from "widgets.slint";

export struct RecentItem {
    name: string,
    detail: string,
    kind: string, // "image", "video", "audio"
}

// One markup mark, in picture pixels. kind: 0 pen, 1 highlighter, 2 arrow, 3 box, 4 text, 5 picture, 6 ellipse, 7 line.
// x, y, w, h: the box round it (its top-left corner and size).
export struct Mark {
    kind: int,
    colour: color,
    width: float,
    commands: string,
    x: float,
    y: float,
    w: float,
    h: float,
    text: string,
    picture: image,
    filled: bool,
}

// One picture in the filmstrip.
export struct Thumb {
    image: image,
    name: string,
    current: bool,
    selected: bool,
}

export global Shell {
    // "home", "image", "audio", "video", "voice", "camera", "settings"
    in-out property <string> page: "home";
    in property <string> title: "Rimelight Media";
    // A downloaded update waiting for a restart (its version), or empty.
    in property <string> update-ready;
    in property <string> toast;
    in property <bool> full-screen;
    in property <[RecentItem]> recents;
    in property <bool> recording;
    in property <string> recording-time;
    in property <bool> drop-hover;
    // The file name in the title (empty when there is no file): click it to rename.
    in property <string> title-name;

    callback rename(string);
    callback open-file();
    callback open-recent(int);
    callback clear-recents();
    callback go(string);
    callback snip(string); // "region", "window", "screen"
    callback record-screen(string); // "region", "window", "screen"
    callback stop-recording();
    callback toggle-full-screen();
    callback apply-update();
    // Back to the empty version of the current tab.
    callback close-tab();
    // The in-app "Save changes to ...?" question (Text tab). confirm-answer: 0 Save, 1 Don't save, 2 Cancel.
    in property <bool> confirm-open;
    in property <string> confirm-name;
    callback confirm-answer(int);
    // Opens the cast popup (and searches for devices).
    callback cast();
    callback key(string, bool, bool, bool) -> bool; // text, ctrl, shift, alt
    // Canvas: the "New canvas" question (Ctrl+N or the top bar) and its answer. preset: 0 window size, 1 1920 x 1080,
    // 2 A4 at 150 dpi, 3 custom (width and height as typed).
    in-out property <bool> canvas-popup-open;
    callback new-canvas(int, string, string, bool);
}

// Casting to a TV or speaker (src/cast.rs): the devices found on the network and the cast in progress.
export global Cast {
    in property <[string]> devices;
    in property <bool> searching;
    // True once a search has ended, so "nothing found" can be told from "still searching".
    in property <bool> searched;
    // The device the file is cast to; empty when not casting.
    in property <string> casting-to;
    in property <bool> playing;
    callback refresh();
    callback pick(int);
    callback pause();
    callback stop();
    callback system-cast();
}

export global Viewer {
    in property <image> picture;
    in property <int> pic-w: 1;
    in property <int> pic-h: 1;
    in property <bool> loading;
    in property <string> error;
    in property <string> position; // "3 / 27"
    in property <bool> has-prev;
    in property <bool> has-next;
    in property <bool> dirty;
    in property <bool> show-info;
    in property <string> info-name;
    in property <string> info-detail;

    // Zoom: fit to the window, or `scale` picture pixels per logical pixel.
    in-out property <bool> fit: true;
    in-out property <float> scale: 1;
    in-out property <length> pan-x;
    in-out property <length> pan-y;

    // "", "crop", "markup", "resize"
    in-out property <string> mode;
    in-out property <float> crop-x: 0;
    in-out property <float> crop-y: 0;
    in-out property <float> crop-w: 1;
    in-out property <float> crop-h: 1;
    // Width over height of the crop box; 0 means free.
    in-out property <float> crop-aspect: 0;

    in property <[Mark]> marks;
    // Tools: 0 pen, 1 highlighter, 2 arrow, 3 box, 4 text, 5 eraser, 6 ellipse, 7 line, 8 eyedropper, 9 paint bucket,
    // 10 rectangle select, 11 move.
    in-out property <int> tool: 0;
    in-out property <color> ink: #E5484D;
    in-out property <float> ink-width: 6;
    // Box and ellipse are filled with the ink.
    in-out property <bool> fill-shape;
    // Up to six recent colours, newest first.
    in property <[color]> recent-colours;
    // A canvas (a new document with no file yet).
    in property <bool> canvas;
    // The rectangle selection (picture pixels), and the mark picked for moving or resizing.
    in property <bool> has-sel;
    in property <float> sel-x;
    in property <float> sel-y;
    in property <float> sel-w;
    in property <float> sel-h;
    in property <bool> has-box;
    in property <float> box-x;
    in property <float> box-y;
    in property <float> box-w;
    in property <float> box-h;
    in property <bool> can-undo;
    in property <bool> can-redo;
    // Where the text tool is typing (picture pixels); -1 when not typing.
    in property <float> text-x: -1;
    in property <float> text-y: -1;
    // The text being typed for the text tool (kept here so Rust can commit it on any exit).
    in-out property <string> pending-text;

    in-out property <string> resize-w;
    in-out property <string> resize-h;
    in-out property <bool> resize-keep: true;

    callback prev();
    callback next();
    callback rotate();
    callback flip(bool); // true: left-right
    callback set-mode(string);
    callback apply-crop();
    callback crop-preset(float);
    callback apply-resize();
    callback resize-edited(bool); // true: width changed
    callback mark-begin(float, float);
    callback mark-move(float, float);
    callback mark-end();
    callback commit-text();
    callback undo();
    callback redo();
    callback clear-marks();
    callback apply-marks();
    callback save();
    callback save-as();
    callback copy();
    callback revert();
    callback toggle-info();
    callback open-folder();

    // Animated GIF / WebP.
    in property <bool> animated;
    in property <bool> anim-playing;
    in property <string> frame-text;
    callback anim-toggle();
    callback anim-step(int);
    callback save-frame();
    // Recycle Bin for a file, discard for a snip that was never saved.
    callback delete-current();

    // Status bar.
    in property <string> file-type;
    in property <string> dims-text;
    in property <string> size-text;
    // The three above joined with " | " for the status bar.
    in property <string> facts-text;
    // The picture is a file (Share and Show in folder need one).
    in property <bool> can-share;
    // The fit-to-window scale the stage computes (for the zoom slider and percentage).
    in-out property <float> fit-scale: 1;
    callback print();
    callback share();

    // Filmstrip, and side-by-side comparison of the pictures picked in it (Ctrl+click).
    in-out property <bool> filmstrip;
    in property <[Thumb]> thumbs;
    in property <bool> comparing;
    in property <[image]> compare-images;
    // The grid for the comparison: columns and rows.
    in property <int> compare-cols: 1;
    in property <int> compare-rows: 1;
    callback toggle-filmstrip();
    callback thumb-clicked(int, bool);
    callback close-compare();

    // Markup tools and colours.
    callback set-tool(int);
    callback pick-colour(color);
    callback pick-hex(string);
    callback crop-selection();
    callback cut-selection();
    callback delete-selection();

    // The colour picker: hue (0 to 360), saturation and value (0 to 1); the colour and pure hue it shows; the hex text.
    in-out property <float> picker-h: 0;
    in-out property <float> picker-s: 1;
    in-out property <float> picker-v: 1;
    in property <color> picker-rgb;
    in property <color> picker-hue;
    in-out property <string> picker-hex;
    callback picker-sync();
    callback picker-changed();
    callback picker-use();
}

export global Player {
    in property <image> frame;
    in property <bool> has-video;
    in property <bool> playing;
    in property <float> position; // 0..1
    in property <string> time-text;
    in property <string> length-text;
    in-out property <float> volume: 1;
    in property <bool> muted;
    // Repeat: 0 off, 1 once more, 2 forever.
    in property <int> loop-mode;
    in property <string> subtitle;
    in property <[Choice]> audio-tracks;
    in property <[Choice]> subtitle-tracks;
    in property <string> media-title;
    in property <string> media-detail;
    in property <string> error;
    in property <bool> buffering;
    in-out property <bool> trim-mode;
    in property <float> trim-start: 0;
    in property <float> trim-end: 1;
    in property <string> trim-text;
    in property <bool> exporting;

    in property <int> video-w: 16;
    in property <int> video-h: 9;
    in property <string> speed-text: "1×";
    in property <[Choice]> speeds;
    // The speed as a number (0.25 to 3), for the speed slider.
    in property <float> speed-value: 1;
    // Status bar: codec, bitrate, sample rate, channels, resolution and fps, duration, size.
    in property <string> meta-text;
    // Waveform of the sound track: an SVG path in a 1 x 2 box (y 0 to 2, centred on 1), and whether it is ready.
    in property <string> wave-commands;
    in property <bool> has-wave;
    // Show the waveform as the seek bar too (the trim range always shows it).
    in-out property <bool> wave-seek: false;
    // Subtitle controls: delay, size, and a picture subtitle placed as fractions of the video.
    in property <string> sub-delay-text: "0 ms";
    in property <float> sub-scale: 1;
    in property <bool> has-sub-picture;
    in property <image> sub-picture;
    in property <float> sub-x;
    in property <float> sub-y;
    in property <float> sub-w;
    in property <float> sub-h;

    callback toggle-play();
    callback seek(float);
    callback seek-preview(float);
    callback skip(int); // seconds
    callback set-volume(float);
    callback toggle-mute();
    callback toggle-loop();
    callback pick-audio(int);
    callback pick-subtitle(int);
    callback load-subtitle-file();
    callback snapshot();
    callback trim-set(bool); // true: start
    callback trim-save();
    callback pick-speed(int);
    callback speed-step(int);
    callback set-speed(float); // 0.25 to 3
    callback trim-drag(bool, float); // true: start; the fraction of the timeline
    callback sub-delay(int); // change in ms; 0 resets
    callback sub-size(int); // -1 smaller, +1 larger, 0 resets
}

// The camera page (src/cameractl.rs): the live preview, photo or video mode, the timer, the grid, the mirror and the
// device list. Rust sets the state; the page's clicks call the callbacks, and Rust sets the values back.
export global Camera {
    in property <image> frame;
    in property <bool> has-frame;
    in property <bool> running;
    in property <bool> recording;
    in property <string> time-text: "0:00";
    // Seconds left before a timed photo (0 when none is counting down).
    in property <int> countdown;
    in property <string> countdown-text;
    in property <image> thumb;
    in property <bool> has-thumb;
    in property <string> status;
    in property <[string]> devices;
    in-out property <int> device-index: 0;
    // True in video mode, false in photo mode.
    in-out property <bool> video-mode: false;
    // 0 off, 1 3 s, 2 5 s, 3 10 s.
    in-out property <int> timer-index: 0;
    in-out property <bool> grid: false;
    in-out property <bool> mirror: true;
    callback shutter();
    callback set-device(int);
    callback set-video(bool);
    callback set-timer(int);
    callback set-grid(bool);
    callback set-mirror(bool);
    callback open-last();
}

export global Voice {
    in property <bool> recording;
    in property <bool> paused;
    in property <string> time-text: "00:00";
    in property <float> level;
    in property <[RecentItem]> takes;
    in property <string> folder;
    // The microphones (the first is the default one) and the file formats; the index of the one picked.
    in property <[string]> mics;
    in-out property <int> mic-index: 0;
    in property <[string]> formats;
    in-out property <int> format-index: 0;
    // Markers added during the recording, as "1   0:12".
    in property <[string]> markers;
    // The take picked in the list (-1 for none), and the new name typed for it.
    in-out property <int> selected: -1;
    in-out property <string> rename-text;
    callback toggle();
    callback pause-toggle();
    callback add-marker();
    callback pick-mic(int);
    callback pick-format(int);
    callback open-take(int);
    callback rename(int, string);
    callback delete(int);
    callback reveal(int);
    callback open-folder();
}

// One Markdown block for the preview. kind: 0 heading (level 1-6), 1 paragraph, 2 list item (indent, check: -1 none,
// 0 open task, 1 done task), 3 code line, 4 quote, 5 table row (level 1 for the header), 6 rule.
export struct MdBlock {
    kind: int,
    level: int,
    indent: int,
    check: int,
    text: string,
}

// One row of the JSON tree: depth, key, value summary; containers fold (open) when clicked.
export struct JsonRow {
    depth: int,
    label: string,
    value: string,
    container: bool,
    open: bool,
    path: string,
}

// The Text tab. Rust reads the editor's text on demand (TextDoc.text) and fills the status, preview and tree.
export global TextDoc {
    // The editor's text (LF line ends) and the caret (byte offset), from the editor.
    in-out property <string> text;
    in-out property <int> caret;
    in property <bool> has-doc;
    in property <string> file-name;
    in property <bool> dirty;
    in property <bool> markdown;
    in property <bool> json;
    in property <string> status;
    // The line under the tools: a JSON error, a result, or nothing.
    in property <string> message;
    // 0 editor only; 1 editor with the preview (Markdown) or the tree (JSON) beside it; 2 preview only (Markdown).
    in-out property <int> view: 0;
    in-out property <bool> word-wrap: true;
    in property <[MdBlock]> md-blocks;
    in property <[JsonRow]> json-rows;
    // The find bar.
    in-out property <bool> find-open: false;
    in property <string> find-status;
    // A selection the find tools set (sel-serial changes each time, so the editor applies it again).
    in property <int> sel-start;
    in property <int> sel-end;
    in property <int> sel-serial;

    callback caret-moved(int);
    callback edited();
    callback save();
    callback save-as();
    callback new-doc();
    callback revert(); // reload the file from disk, dropping the changes
    callback format-json(int); // 2 or 4 spaces
    callback minify-json();
    callback validate-json();
    callback sort-json();
    callback toggle-node(string);
    callback find-next(string);
    callback replace-one(string, string);
    callback replace-all(string, string);
}

export global Settings {
    in-out property <int> theme: 2; // 0 light, 1 dark, 2 system
    in-out property <bool> background: false;
    in-out property <bool> desktop-shortcut: true;
    // Print Screen goes to Rimelight Media (Windows' own Print Screen snipping is off).
    in-out property <bool> printscreen-ours: false;
    in-out property <bool> snip-copy: true;
    in-out property <bool> snip-save: true;
    in-out property <bool> snip-open: true;
    in-out property <bool> rec-system-audio: true;
    in-out property <bool> rec-mic: false;
    in-out property <int> rec-fps: 30;
    in property <string> hotkeys-status;
    in property <string> screenshot-folder;
    in property <string> recording-folder;
    in property <bool> installed;
    in property <string> install-state;
    in property <string> update-state;
    in property <string> defaults-state;
    in property <string> about;

    callback changed();
    callback check-updates();
    callback open-releases();
    callback register-defaults();
    callback open-default-settings();
    callback open-printscreen-settings();
    callback pick-folder(bool); // true: screenshots
    in property <string> canvas-folder;
    callback pick-canvas-folder();
}
