// The camera, in place of Windows' Camera app: a big live preview with a grid, photo or video, a timer, a mirror, the
// device list, a round shutter on the right and the last capture's thumbnail in the corner.
import { ComboBox } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Icons } from "icons.slint";
import { Camera } from "state.slint";

// A small toggle chip under the preview.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    height: Tokens.control-height;
    min-width: label.preferred-width + Tokens.space-5;
    border-radius: Tokens.radius-control;
    background: !root.enabled ? transparent
        : root.active ? Tokens.accent-fill
        : ta.has-hover ? Tokens.surface-hover : Tokens.surface-raised;
    border-width: root.active ? 0px : 1px;
    border-color: Tokens.border-subtle;
    accessible-role: button;
    accessible-label: root.text;

    label := Text {
        text: root.text;
        color: !root.enabled ? Tokens.text-faint : root.active ? Tokens.text-on-accent : Tokens.text-primary;
        font-size: Type.body;
        font-weight: root.active ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CameraPage inherits Rectangle {
    background: Tokens.stage;

    property <[string]> timers: ["Off", "3 s", "5 s", "10 s"];

    HorizontalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-4;

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-3;

            // Device list (top left) and the stage with the preview.
            HorizontalLayout {
                spacing: Tokens.space-3;
                alignment: start;
                ComboBox {
                    model: Camera.devices;
                    current-index: Camera.device-index;
                    width: 280px;
                    enabled: Camera.devices.length > 0 && !Camera.recording;
                    selected(value) => { Camera.set-device(self.current-index); }
                }
            }

            Rectangle {
                vertical-stretch: 1;
                background: #000000;
                border-radius: Tokens.radius-r8;
                clip: true;

                if Camera.has-frame: Image {
                    width: 100%;
                    height: 100%;
                    source: Camera.frame;
                    image-fit: contain;
                }

                // Rule-of-thirds grid over the whole preview.
                if Camera.grid && Camera.has-frame: Rectangle {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { y: parent.height / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                    Rectangle { y: parent.height * 2 / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                }

                if !Camera.has-frame: Text {
                    text: Camera.status != "" ? Camera.status : (Camera.running ? "Starting the camera..." : "Choose a camera");
                    color: Tokens.text-on-stage;
                    font-size: Type.heading;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // The photo timer's count.
                if Camera.countdown > 0: Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 70px;
                    background: #00000090;
                    Text {
                        text: Camera.countdown-text;
                        color: #FFFFFF;
                        font-size: 72px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Video time, with a red dot while recording.
                if Camera.recording: Rectangle {
                    x: Tokens.space-3;
                    y: Tokens.space-3;
                    width: rec-row.preferred-width + Tokens.space-4;
                    height: 32px;
                    border-radius: Tokens.radius-control;
                    background: #000000A0;
                    rec-row := HorizontalLayout {
                        padding-left: Tokens.space-3;
                        padding-right: Tokens.space-3;
                        spacing: Tokens.space-2;
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.record-red; }
                        }
                        Text { text: Camera.time-text; color: #FFFFFF; font-size: Type.body; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }

            // Mode, timer, mirror and grid.
            HorizontalLayout {
                spacing: Tokens.space-2;
                alignment: center;
                Chip { text: "Photo"; active: !Camera.video-mode; enabled: !Camera.recording; clicked => { Camera.set-video(false); } }
                Chip { text: "Video"; active: Camera.video-mode; enabled: !Camera.recording; clicked => { Camera.set-video(true); } }
                Rectangle { width: Tokens.space-3; }
                for label[i] in timers: Chip {
                    text: label;
                    active: Camera.timer-index == i;
                    enabled: !Camera.video-mode && Camera.countdown == 0;
                    clicked => { Camera.set-timer(i); }
                }
                Rectangle { width: Tokens.space-3; }
                Chip { text: "Mirror"; active: Camera.mirror; clicked => { Camera.set-mirror(!Camera.mirror); } }
                Chip { text: "Grid"; active: Camera.grid; clicked => { Camera.set-grid(!Camera.grid); } }
            }
        }

        // The shutter and the thumbnail.
        VerticalLayout {
            width: 120px;
            spacing: Tokens.space-4;
            alignment: center;

            Rectangle {
                height: 96px;
                width: 96px;
                border-radius: 48px;
                border-width: 4px;
                border-color: #FFFFFF;
                background: shutter-ta.has-hover ? #FFFFFF26 : transparent;
                Rectangle {
                    width: 76px;
                    height: 76px;
                    border-radius: 38px;
                    background: Camera.video-mode ? Tokens.record-red : #FFFFFF;
                    Image {
                        visible: Camera.recording;
                        source: Icons.stop;
                        width: 30px;
                        height: 30px;
                        colorize: #FFFFFF;
                    }
                }
                shutter-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { Camera.shutter(); }
                }
            }

            Rectangle { vertical-stretch: 1; }

            // The last capture: a click opens it.
            HorizontalLayout {
                alignment: center;
                Rectangle {
                height: 84px;
                width: 84px;
                border-radius: Tokens.radius-control;
                clip: true;
                background: Tokens.surface-sunken;
                border-width: 1px;
                border-color: #FFFFFF40;
                if Camera.has-thumb: Image {
                    width: 100%;
                    height: 100%;
                    source: Camera.thumb;
                    image-fit: cover;
                }
                if !Camera.has-thumb: Image {
                    width: Tokens.icon-medium;
                    height: Tokens.icon-medium;
                    source: Icons.image;
                    colorize: Tokens.text-muted;
                }
                thumb-ta := TouchArea {
                    enabled: Camera.has-thumb;
                    mouse-cursor: pointer;
                    clicked => { Camera.open-last(); }
                }
                }
            }
        }
    }
}
