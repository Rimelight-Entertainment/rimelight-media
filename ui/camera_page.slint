// The camera, in place of Windows' Camera app: the options in the top bar (device, Photo or Video, timer, mirror, grid),
// the live preview in the middle with the shutter and the last capture's thumbnail on the right, and the resolution and
// save folder in the status bar. With no camera, the preview shows "No camera found" and a Check again button.
import { ComboBox } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Icons } from "icons.slint";
import { Button, ButtonKind, IconButton, ToolBar, StatusBar, ToolDivider } from "widgets.slint";
import { Camera } from "state.slint";

// A small toggle chip in the top bar.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <bool> enabled: true;
    callback clicked();

    height: Tokens.control-height;
    min-width: label.preferred-width + Tokens.space-5;
    border-radius: Tokens.radius-control;
    background: !root.enabled ? transparent
        : root.active ? Tokens.accent-fill
        : ta.has-hover ? Tokens.surface-hover : Tokens.surface-raised;
    border-width: root.active ? 0px : 1px;
    border-color: Tokens.border-subtle;
    accessible-role: button;
    accessible-label: root.text;

    label := Text {
        text: root.text;
        color: !root.enabled ? Tokens.text-faint : root.active ? Tokens.text-on-accent : Tokens.text-primary;
        font-size: Type.body;
        // The weight stays the same in both states, so the chip never changes width; only the colour changes.
        font-weight: 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component CameraPage inherits Rectangle {
    background: Tokens.surface-base;

    property <[string]> timers: ["Off", "3 s", "5 s", "10 s"];
    // The shutter is 80 px; the thumbnail is 60% of it, so both sit on one centred column.
    property <length> shutter-size: 80px;
    property <length> thumb-size: 48px;

    VerticalLayout {
        // Options: the device, the mode, the timer, the mirror and the grid.
        ToolBar {
            IconButton { icon: Icons.camera; label: "Camera"; clicked => { } }
            ComboBox {
                model: Camera.devices;
                current-index: Camera.device-index;
                width: 240px;
                enabled: Camera.devices.length > 0 && !Camera.recording;
                selected(value) => { Camera.set-device(self.current-index); }
            }
            ToolDivider { }
            Chip { text: "Photo"; active: !Camera.video-mode; enabled: !Camera.recording; clicked => { Camera.set-video(false); } }
            Chip { text: "Video"; active: Camera.video-mode; enabled: !Camera.recording; clicked => { Camera.set-video(true); } }
            ToolDivider { }
            for label[i] in timers: Chip {
                text: label;
                active: Camera.timer-index == i;
                enabled: !Camera.video-mode && Camera.countdown == 0;
                clicked => { Camera.set-timer(i); }
            }
            ToolDivider { }
            Chip { text: "Mirror"; active: Camera.mirror; clicked => { Camera.set-mirror(!Camera.mirror); } }
            Chip { text: "Grid"; active: Camera.grid; clicked => { Camera.set-grid(!Camera.grid); } }
        }

        // The preview, and the shutter with the thumbnail on the right.
        HorizontalLayout {
            vertical-stretch: 1;
            padding: Tokens.space-4;
            spacing: Tokens.space-4;

            Rectangle {
                horizontal-stretch: 1;
                background: #000000;
                border-radius: Tokens.radius-r8;
                clip: true;

                if Camera.has-frame: Image {
                    width: 100%;
                    height: 100%;
                    source: Camera.frame;
                    image-fit: contain;
                }

                // Rule-of-thirds grid over the whole preview.
                if Camera.grid && Camera.has-frame: Rectangle {
                    x: 0; y: 0; width: parent.width; height: parent.height;
                    Rectangle { x: parent.width / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { x: parent.width * 2 / 3; width: 1px; height: parent.height; background: #FFFFFF73; }
                    Rectangle { y: parent.height / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                    Rectangle { y: parent.height * 2 / 3; height: 1px; width: parent.width; background: #FFFFFF73; }
                }

                // No camera: a centred message with Check again.
                if Camera.devices.length == 0: VerticalLayout {
                    width: parent.width;
                    height: parent.height;
                    alignment: center;
                    spacing: Tokens.space-3;
                    Text {
                        text: "No camera found";
                        color: Tokens.text-on-stage;
                        font-size: Type.heading;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button { text: "Check again"; kind: ButtonKind.secondary; clicked => { Camera.check-again(); } }
                    }
                }

                // A camera that is not showing a picture yet: its status, or the hint to pick one.
                if Camera.devices.length > 0 && !Camera.has-frame: Text {
                    text: Camera.status != "" ? Camera.status : (Camera.running ? "Starting the camera..." : "Choose a camera");
                    color: Tokens.text-on-stage;
                    font-size: Type.heading;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                // The photo timer's count.
                if Camera.countdown > 0: Rectangle {
                    width: 140px;
                    height: 140px;
                    border-radius: 70px;
                    background: #00000090;
                    Text {
                        text: Camera.countdown-text;
                        color: #FFFFFF;
                        font-size: 72px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Video time, with a red dot while recording.
                if Camera.recording: Rectangle {
                    x: Tokens.space-3;
                    y: Tokens.space-3;
                    width: rec-row.preferred-width + Tokens.space-4;
                    height: 32px;
                    border-radius: Tokens.radius-control;
                    background: #000000A0;
                    rec-row := HorizontalLayout {
                        padding-left: Tokens.space-3;
                        padding-right: Tokens.space-3;
                        spacing: Tokens.space-2;
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.record-red; }
                        }
                        Text { text: Camera.time-text; color: #FFFFFF; font-size: Type.body; font-weight: 600; vertical-alignment: center; }
                    }
                }
            }

            // One column: the shutter, then the thumbnail, both centred on the same vertical axis.
            VerticalLayout {
                width: 120px;
                spacing: Tokens.space-5;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.shutter-size;
                        height: root.shutter-size;
                        border-radius: root.shutter-size / 2;
                        border-width: 4px;
                        border-color: #FFFFFF;
                        background: shutter-ta.has-hover ? #FFFFFF26 : transparent;
                        Rectangle {
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            x: 8px;
                            y: 8px;
                            border-radius: self.width / 2;
                            background: Camera.video-mode ? Tokens.record-red : #FFFFFF;
                            Image {
                                visible: Camera.recording;
                                source: Icons.stop;
                                width: 30px;
                                height: 30px;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                colorize: #FFFFFF;
                            }
                        }
                        shutter-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Camera.shutter(); }
                        }
                    }
                }

                // The last capture: a click opens it.
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: root.thumb-size;
                        height: root.thumb-size;
                        border-radius: Tokens.radius-control;
                        clip: true;
                        background: Tokens.surface-sunken;
                        border-width: 1px;
                        border-color: Tokens.border-subtle;
                        if Camera.has-thumb: Image {
                            width: 100%;
                            height: 100%;
                            source: Camera.thumb;
                            image-fit: cover;
                        }
                        if !Camera.has-thumb: Image {
                            width: Tokens.icon-medium;
                            height: Tokens.icon-medium;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            source: Icons.image;
                            colorize: Tokens.text-muted;
                        }
                        thumb-ta := TouchArea {
                            enabled: Camera.has-thumb;
                            mouse-cursor: pointer;
                            clicked => { Camera.open-last(); }
                        }
                    }
                }
            }
        }

        // Left: the resolution and the save folder. Right: the recording time while recording.
        StatusBar {
            left-text: Camera.resolution != "" ? Camera.resolution + " | " + Camera.save-folder : Camera.save-folder;
            if Camera.recording: Text {
                text: "● " + Camera.time-text;
                color: Tokens.record-red;
                font-size: Type.caption;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }
}
