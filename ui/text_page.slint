// Text tab: an editor for plain text (Notepad's job), the Markdown preview beside it or alone, and the JSON tools with a
// collapsible tree. Rust (src/textctl.rs) fills the status line, the preview blocks and the tree.
import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Icons } from "icons.slint";
import { Button, ButtonKind, IconButton, ToolBar, ActionRow, StatusBar, ToolDivider, EmptyState } from "widgets.slint";
import { Shell, TextDoc, MdBlock, MdCell, JsonRow } from "state.slint";

// The editor: a TextInput in a scroll view (wrapping, or scrolling sideways when wrap is off; a code file never wraps).
// The syntax colours are Text layers under the TextInput, whose own text is transparent (its caret and selection stay).
// It takes the focus when a new document is made (focus-serial changes) and when it is created.
component Editor inherits ScrollView {
    in property <int> focus-serial;
    // Whether the lines wrap: the word-wrap switch, except for a code file (its colour layers need one line per line).
    property <bool> wrapping: TextDoc.word-wrap && !TextDoc.code-file;
    // The face: code files are always mono; plain text uses the font chosen in the toolbar (0 Mono, 1 Sans, 2 Serif).
    property <string> face: (TextDoc.code-file || TextDoc.text-font == 0) ? "Consolas" : (TextDoc.text-font == 1 ? "Segoe UI" : "Georgia");
    // The height of one line, and of the text up to the caret (a hidden Text lays out caret-prefix as the editor does).
    property <length> line-h: probe.preferred-height;
    property <length> caret-bottom: input.y + measure.preferred-height;
    horizontal-stretch: 1;
    vertical-stretch: 1;
    content-width: root.wrapping ? self.visible-width : max(self.visible-width, input.preferred-width + 2 * Tokens.space-3);
    content-height: max(self.visible-height, input.preferred-height + 2 * Tokens.space-3);

    changed focus-serial => { input.focus(); }
    init => { input.focus(); }
    // Keeps the caret in view: scrolls down when it is under the bottom edge, up when it is above the top.
    changed caret-bottom => { root.reveal(); }
    function reveal() {
        if (root.content-y + root.caret-bottom > root.visible-height - Tokens.space-3) {
            root.content-y = min(0px, root.visible-height - Tokens.space-3 - root.caret-bottom);
        }
        if (root.content-y + root.caret-bottom - root.line-h < Tokens.space-3) {
            root.content-y = min(0px, Tokens.space-3 + root.line-h - root.caret-bottom);
        }
    }


    probe := Text { x: 0px; y: 0px; text: "Mg"; font-family: root.face; font-size: 14px; opacity: 0; }
    measure := Text {
        x: Tokens.space-3;
        y: 0px;
        width: input.width;
        text: TextDoc.caret-prefix;
        font-family: root.face;
        font-size: 14px;
        wrap: root.wrapping ? TextWrap.word-wrap : TextWrap.no-wrap;
        opacity: 0;
    }

    // The colour layers (highlight.rs): each kind's characters in its colour, in a monospace copy of the text. Drawn
    // under the TextInput.
    for layer[i] in TextDoc.hl-texts: Text {
        x: Tokens.space-3;
        y: Tokens.space-3;
        text: layer;
        font-family: root.face;
        font-size: 14px;
        color: TextDoc.hl-colours[i];
        wrap: TextWrap.no-wrap;
        visible: TextDoc.hl-on;
    }

    input := TextInput {
        x: Tokens.space-3;
        y: Tokens.space-3;
        width: root.wrapping ? root.visible-width - 2 * Tokens.space-3 : self.preferred-width;
        font-family: root.face;
        font-size: 14px;
        // Transparent while the colour layers show the text (the caret and selection still draw).
        color: TextDoc.hl-on ? transparent : Tokens.text-primary;
        selection-background-color: Tokens.selection;
        wrap: root.wrapping ? TextWrap.word-wrap : TextWrap.no-wrap;
        single-line: false;
        text <=> TextDoc.text;
        // The selection the find tools ask for (applied again each time the serial changes).
        property <int> serial: TextDoc.sel-serial;
        changed serial => { self.set-selection-offsets(TextDoc.sel-start, TextDoc.sel-end); }
        changed cursor-position-byte-offset => { TextDoc.caret-moved(self.cursor-position-byte-offset); }
        edited => { TextDoc.edited(); }
        key-pressed(e) => {
            if e.modifiers.control && e.text == "s" {
                if e.modifiers.shift { TextDoc.save-as(); } else { TextDoc.save(); }
                return accept;
            }
            if e.modifiers.control && e.text == "n" {
                TextDoc.new-doc();
                return accept;
            }
            if e.modifiers.control && e.text == "f" {
                TextDoc.find-open = !TextDoc.find-open;
                return accept;
            }
            reject
        }
    }
}

// The Markdown preview: one block per paragraph, list item, quote, code block, table or rule. Inline styles (bold,
// italic, code, strikethrough, links) come in `styled` and are drawn by StyledText, which wraps them. The preview font is
// Segoe UI, which has the italic face (the variable Segoe UI the app uses for the rest has none, so *italic* showed upright).
component MdLine inherits VerticalLayout {
    in property <MdBlock> block;
    spacing: Tokens.space-2;

    if root.block.kind == 6: Rectangle { height: 1px; background: Tokens.border-subtle; }
    if root.block.kind == 0: StyledText {
        text: root.block.styled;
        default-color: Tokens.text-primary;
        default-font-family: "Segoe UI";
        default-font-size: root.block.level <= 2 ? Type.heading : Type.subheading;
        link-color: Tokens.accent-text;
        horizontal-stretch: 1;
        link-clicked(url) => { TextDoc.open-link(url); }
    }
    if root.block.kind == 1: StyledText {
        text: root.block.styled;
        default-color: Tokens.text-primary;
        default-font-family: "Segoe UI";
        default-font-size: Type.body;
        link-color: Tokens.accent-text;
        horizontal-stretch: 1;
        link-clicked(url) => { TextDoc.open-link(url); }
    }
    if root.block.kind == 2: HorizontalLayout {
        padding-left: root.block.indent * 20px;
        spacing: Tokens.space-2;
        alignment: start;
        // A bullet (per nesting level) or the number of an ordered item.
        if root.block.check < 0: Text {
            text: root.block.marker;
            color: Tokens.text-muted;
            font-size: Type.body;
            min-width: 24px;
            vertical-alignment: top;
        }
        if root.block.check >= 0: Rectangle {
            width: 14px;
            height: 14px;
            y: 3px;
            border-width: 1px;
            border-radius: 3px;
            border-color: Tokens.border-strong;
            background: root.block.check == 1 ? Tokens.accent-fill : transparent;
            if root.block.check == 1: Image { source: Icons.check; width: 12px; height: 12px; colorize: Tokens.text-on-accent; }
        }
        StyledText {
            text: root.block.styled;
            default-color: root.block.check == 1 ? Tokens.text-muted : Tokens.text-primary;
            default-font-family: "Segoe UI";
            default-font-size: Type.body;
            link-color: Tokens.accent-text;
            horizontal-stretch: 1;
            link-clicked(url) => { TextDoc.open-link(url); }
        }
    }
    // The whole code block in one dark rounded box, its lines in one monospace Text (no gaps between lines).
    if root.block.kind == 3: Rectangle {
        background: Tokens.surface-sunken;
        border-radius: Tokens.radius-control;
        VerticalLayout {
            padding: Tokens.space-3;
            Text {
                text: root.block.text;
                color: Tokens.text-primary;
                font-family: "Consolas";
                font-size: 13px;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }
    }
    // The quote: one block, with its bar down the left of all its lines.
    if root.block.kind == 4: HorizontalLayout {
        spacing: Tokens.space-3;
        Rectangle { width: 3px; background: Tokens.border-strong; border-radius: 1.5px; }
        StyledText {
            text: root.block.styled;
            default-color: Tokens.text-muted;
            default-font-family: "Segoe UI";
            default-font-size: Type.body;
            link-color: Tokens.accent-text;
            horizontal-stretch: 1;
            link-clicked(url) => { TextDoc.open-link(url); }
        }
    }
    // The table: a grid of cells with 1px borders and a header background (Rust sets each cell's row and column).
    if root.block.kind == 7: GridLayout {
        spacing: 0px;
        for c in root.block.cells: Rectangle {
            row: c.row;
            col: c.col;
            background: c.header ? Tokens.surface-sunken : transparent;
            border-width: 1px;
            border-color: Tokens.border-subtle;
            VerticalLayout {
                padding: Tokens.space-2;
                StyledText {
                    text: c.styled;
                    default-color: Tokens.text-primary;
                    default-font-family: "Segoe UI";
                    default-font-size: Type.body;
                    link-color: Tokens.accent-text;
                    horizontal-stretch: 1;
                    link-clicked(url) => { TextDoc.open-link(url); }
                }
            }
        }
    }
}

component Preview inherits ScrollView {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    content-width: self.visible-width;
    content-height: body.preferred-height;
    body := VerticalLayout {
        width: root.visible-width;
        padding: Tokens.space-5;
        spacing: Tokens.space-3;
        alignment: start;
        for b in TextDoc.md-blocks: MdLine { block: b; }
    }
}

// One row of the JSON tree. Containers fold when clicked.
component TreeRow inherits Rectangle {
    in property <JsonRow> item;
    height: 24px;
    background: ta.has-hover ? Tokens.surface-hover : transparent;
    HorizontalLayout {
        padding-left: Tokens.space-2 + root.item.depth * 16px;
        padding-right: Tokens.space-2;
        spacing: Tokens.space-1;
        Text {
            text: root.item.container ? (root.item.open ? "▾" : "▸") : "";
            color: Tokens.text-muted;
            font-size: Type.body;
            width: 14px;
            vertical-alignment: center;
        }
        Text { text: root.item.label; color: Tokens.accent-text; font-family: "Consolas"; font-size: 13px; vertical-alignment: center; }
        Text { text: root.item.value; color: root.item.container ? Tokens.text-muted : Tokens.text-primary; font-family: "Consolas"; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { if root.item.container { TextDoc.toggle-node(root.item.path); } }
    }
}

component Tree inherits ScrollView {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    content-width: self.visible-width;
    content-height: body.preferred-height;
    body := VerticalLayout {
        width: root.visible-width;
        padding: Tokens.space-3;
        spacing: 0px;
        alignment: start;
        if TextDoc.json-rows.length == 0: Text {
            text: "Not valid JSON yet. Use Validate to find the error.";
            color: Tokens.text-muted;
            font-size: Type.body;
            wrap: word-wrap;
        }
        for r in TextDoc.json-rows: TreeRow { item: r; }
    }
}

export component TextPage inherits Rectangle {
    background: Tokens.surface-base;
    property <string> find-text;
    property <string> repl-text;

    VerticalLayout {
        // Main toolbar, as the picture page's: file actions on the left (icons with tooltips), the views and the
        // find and wrap switches on the right, and the file type last.
        // Always shown, as on every tab: with no document the file buttons are disabled.
        ToolBar {
            IconButton { icon: Icons.folder-open; label: "Open a file"; clicked => { Shell.open-file(); } }
            ToolDivider { }
            IconButton { icon: Icons.save; label: "Save (Ctrl+S)"; enabled: TextDoc.has-doc && (TextDoc.dirty || TextDoc.file-name == ""); clicked => { TextDoc.save(); } }
            IconButton { icon: Icons.save-as; label: "Save as (Ctrl+Shift+S)"; enabled: TextDoc.has-doc; clicked => { TextDoc.save-as(); } }
            IconButton { icon: Icons.x; label: "Discard changes"; enabled: TextDoc.has-doc && TextDoc.dirty; clicked => { TextDoc.revert(); } }
            ToolDivider { }
            Text {
                text: !TextDoc.has-doc ? "" : TextDoc.file-name == "" ? "Untitled" : TextDoc.file-name;
                color: Tokens.text-primary;
                font-size: Type.body;
                font-weight: 600;
                vertical-alignment: center;
                overflow: elide;
                max-width: 260px;
            }
            Rectangle { horizontal-stretch: 1; }
            // Markdown views, as JetBrains' editor and preview switch: editor only, split, preview only.
            if TextDoc.markdown: IconButton { icon: Icons.md-editor; label: "Editor only"; active: TextDoc.view == 0; enabled: TextDoc.has-doc; clicked => { TextDoc.view = 0; } }
            if TextDoc.markdown: IconButton { icon: Icons.columns; label: "Split: editor and preview"; active: TextDoc.view == 1; enabled: TextDoc.has-doc; clicked => { TextDoc.view = 1; } }
            if TextDoc.markdown: IconButton { icon: Icons.eye; label: "Preview only"; active: TextDoc.view == 2; enabled: TextDoc.has-doc; clicked => { TextDoc.view = 2; } }
            // JSON views, as the Markdown ones: the text editor, or the collapsible tree.
            if TextDoc.json: IconButton { icon: Icons.file-code; label: "Editor: edit the JSON text"; active: TextDoc.view == 0; enabled: TextDoc.has-doc; clicked => { TextDoc.view = 0; } }
            if TextDoc.json: IconButton { icon: Icons.list-tree; label: "Tree: browse the JSON, folding its objects and arrays"; active: TextDoc.view == 1; enabled: TextDoc.has-doc; clicked => { TextDoc.view = 1; } }
            if TextDoc.markdown || TextDoc.json: ToolDivider { }
            // The font of plain text (hidden for a code file, which is always mono).
            if !TextDoc.code-file: ComboBox {
                model: ["Mono", "Sans", "Serif"];
                current-index <=> TextDoc.text-font;
                enabled: TextDoc.has-doc;
                width: 100px;
                height: Tokens.control-height;
                changed current-index => { TextDoc.set-text-font(self.current-index); }
            }
            if !TextDoc.code-file: ToolDivider { }
            IconButton { icon: Icons.text-wrap; label: "Word wrap"; active: TextDoc.word-wrap; enabled: TextDoc.has-doc; clicked => { TextDoc.word-wrap = !TextDoc.word-wrap; } }
            IconButton { icon: Icons.search; label: "Find (Ctrl+F)"; active: TextDoc.find-open; enabled: TextDoc.has-doc; clicked => { TextDoc.find-open = !TextDoc.find-open; } }
            ToolDivider { }
            // The file type: sets the mode now; Save as uses its extension by default. Changing it never renames a file.
            ComboBox {
                model: ["Plain text", "Markdown", "JSON", "TOML", "YAML", "XML", "CSV", "INI", "Log"];
                current-index <=> TextDoc.kind;
                enabled: TextDoc.has-doc;
                width: 128px;
                height: Tokens.control-height;
                changed current-index => { TextDoc.set-kind(self.current-index); }
            }
            if Shell.recording || TextDoc.has-doc: ToolDivider { }
            if Shell.recording: IconButton { icon: Icons.stop; label: "Stop recording"; clicked => { Shell.stop-recording(); } }
            // Closes the text back to the empty tab (shown only when a document is open).
            if TextDoc.has-doc: IconButton { icon: Icons.x; label: "Close the text"; clicked => { Shell.close-tab(); } }
        }

        // JSON tools, as an edit row under the toolbar: icons only, each with a tooltip that says what it does, and the
        // tool's message.
        if TextDoc.has-doc && TextDoc.json: ActionRow {
            IconButton { icon: Icons.indent-increase; label: "Format with 2-space indent"; clicked => { TextDoc.format-json(2); } }
            IconButton { icon: Icons.list-indent; label: "Format with 4-space indent"; clicked => { TextDoc.format-json(4); } }
            IconButton { icon: Icons.minimize; label: "Minify: remove all spaces and line breaks"; clicked => { TextDoc.minify-json(); } }
            IconButton { icon: Icons.check; label: "Validate: check the JSON and show where it fails"; clicked => { TextDoc.validate-json(); } }
            IconButton { icon: Icons.sort-az; label: "Sort keys A to Z at every level"; clicked => { TextDoc.sort-json(); } }
            if TextDoc.message != "": ToolDivider { }
            Text {
                text: TextDoc.message;
                color: Tokens.text-muted;
                font-size: Type.caption;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
        }

        // The find bar (Ctrl+F): the Find and Replace fields, the count, previous and next, Replace and Replace all on
        // the left; the close button flush right.
        if TextDoc.has-doc && TextDoc.find-open: ActionRow {
            LineEdit {
                placeholder-text: "Find";
                width: 220px;
                height: Tokens.control-height;
                text <=> root.find-text;
                accepted => { TextDoc.find-next(root.find-text); }
            }
            LineEdit {
                placeholder-text: "Replace with";
                width: 220px;
                height: Tokens.control-height;
                text <=> root.repl-text;
            }
            Text {
                text: TextDoc.find-status;
                color: Tokens.text-muted;
                font-size: Type.caption;
                vertical-alignment: center;
                horizontal-alignment: center;
                min-width: 72px;
                overflow: elide;
            }
            IconButton { icon: Icons.chevron-up; label: "Previous match"; clicked => { TextDoc.find-prev(root.find-text); } }
            IconButton { icon: Icons.chevron-down; label: "Next match"; clicked => { TextDoc.find-next(root.find-text); } }
            Button { text: "Replace"; kind: ButtonKind.secondary; clicked => { TextDoc.replace-one(root.find-text, root.repl-text); } }
            Button { text: "Replace all"; kind: ButtonKind.secondary; clicked => { TextDoc.replace-all(root.find-text, root.repl-text); } }
            Rectangle { horizontal-stretch: 1; }
            IconButton { icon: Icons.x; label: "Close the find bar"; clicked => { TextDoc.find-open = false; } }
        }

        // The body: the editor, and the preview or tree beside it (or the preview alone).
        Rectangle {
            vertical-stretch: 1;
            if !TextDoc.has-doc: EmptyState {
                width: parent.width;
                height: parent.height;
                icon: Icons.text;
                icon-colour: Tokens.file-text;
                title: "Open a text file";
                formats: ".bat, .cfg, .conf, .css, .csv, .env, .html, .ini, .js, .json, .log, .markdown, .md, .ps1, .rs, .sh, .text, .toml, .ts, .txt, .xml, .yaml, .yml";
                open-text: "Open a file";
                new-text: "New text file";
                new-icon: Icons.file-plus;
                recents: Shell.recents-text;
                open => { Shell.open-file(); }
                new-file => { TextDoc.new-doc(); }
                open-recent(i) => { Shell.open-recent(i); }
                clear-recents => { Shell.clear-recents("text"); }
            }
            if TextDoc.has-doc: HorizontalLayout {
                if !(TextDoc.markdown && TextDoc.view == 2): Editor { focus-serial: TextDoc.focus-serial; }
                if (TextDoc.markdown && TextDoc.view >= 1) || (TextDoc.json && TextDoc.view == 1): Rectangle {
                    width: 1px;
                    background: Tokens.border-subtle;
                }
                if TextDoc.markdown && TextDoc.view >= 1: Preview { }
                if TextDoc.json && TextDoc.view == 1: Tree { }
            }
        }

        // The status bar, as on every tab: "Ln 1, Col 1 | 0 characters | LF | UTF-8" (empty with no document).
        // The saved state comes first, always shown (no layout shift on edit): "Saved" when clean, "Unsaved" when
        // dirty or never saved. It is as wide as "Unsaved" and is followed by the same " | "
        // separator as the rest.
        StatusBar {
          // One row with no spacing, so the " | " after the saved state matches the separators inside the status text.
          HorizontalLayout {
            spacing: 0;
            horizontal-stretch: 1;
            if TextDoc.has-doc: Rectangle {
                // As wide as the longest label, so the bar never shifts when the state changes.
                width: widest.preferred-width;
                widest := Text { text: "Unsaved"; font-size: Type.caption; opacity: 0; }
                saved-state := Text {
                    x: 0; width: parent.width;
                    text: (TextDoc.dirty || TextDoc.file-name == "") ? "Unsaved" : "Saved";
                    color: (TextDoc.dirty || TextDoc.file-name == "") ? Tokens.status-warning : Tokens.text-muted;
                    font-size: Type.caption;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
            Text {
                text: TextDoc.has-doc ? " | " + TextDoc.status : TextDoc.status;
                color: Tokens.text-muted;
                font-size: Type.caption;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
          }
        }
    }
}
