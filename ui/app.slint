// Rimelight Media: one window for pictures, video, music, voice recording and settings. Snips and recordings use the windows in
// capture.slint.
import { Tokens, Type, ThemeChoice } from "tokens.slint";
import { Icons } from "icons.slint";
import { IconButton, Button, ButtonKind, Choice, TipBounds, ConfirmDialog } from "widgets.slint";
import { Shell, Viewer, Player, Voice, Camera, Settings, TextDoc, RecentItem, Mark, MdBlock, JsonRow, Cast } from "state.slint";
import { CastPopup } from "cast_popup.slint";
import { HomePage } from "home.slint";
import { ImagePage } from "image_page.slint";
import { MediaPage } from "media_page.slint";
import { VoicePage } from "voice_page.slint";
import { CameraPage } from "camera_page.slint";
import { SettingsPage } from "settings_page.slint";
import { TextPage } from "text_page.slint";

export { Shell, Viewer, Player, Voice, Camera, Settings, TextDoc, Tokens, ThemeChoice, RecentItem, Mark, MdBlock, JsonRow, Choice, Cast }
export { SnipWindow, RecBar, Tray, WindowBox } from "capture.slint";
export { SetupWindow } from "setup.slint";

component NavButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> active;
    // Show the icon in its own colours (the app logo).
    in property <bool> full-colour;
    callback clicked();
    height: Tokens.control-height;
    width: row.preferred-width + Tokens.space-4;
    border-radius: Tokens.radius-control;
    background: active ? Tokens.surface-pressed : ta.has-hover ? Tokens.surface-hover : transparent;
    accessible-role: tab;
    accessible-label: label;
    row := HorizontalLayout {
        alignment: center;
        spacing: Tokens.space-2;
        if !root.full-colour: Rectangle {
            width: Tokens.icon-small;
            Image { source: root.icon; width: Tokens.icon-small; height: Tokens.icon-small; colorize: root.active ? Tokens.accent-text : Tokens.text-muted; }
        }
        if root.full-colour: Rectangle {
            width: 18px;
            Image { source: root.icon; width: 18px; height: 18px; }
        }
        Text { text: root.label; color: root.active ? Tokens.text-primary : Tokens.text-muted; font-size: Type.body; vertical-alignment: center; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The Audio and Video tabs: the player when what's loaded is that kind, otherwise an empty page.
component MediaSlot inherits Rectangle {
    in property <bool> want-video;
    background: Tokens.stage;
    if Player.media-title != "" && Player.has-video == root.want-video: MediaPage { }
    if !(Player.media-title != "" && Player.has-video == root.want-video): VerticalLayout {
        alignment: center;
        spacing: Tokens.space-3;
        Text {
            text: root.want-video ? "No video open" : "No music open";
            color: Tokens.text-on-stage;
            font-size: Type.heading;
            horizontal-alignment: center;
        }
        if Player.media-title != "": Text {
            text: (Player.has-video ? "Playing a video: " : "Playing: ") + Player.media-title;
            color: #9AA4B2;
            font-size: Type.body;
            horizontal-alignment: center;
        }
        HorizontalLayout {
            alignment: center;
            Button { text: root.want-video ? "Open a video" : "Open music"; kind: ButtonKind.primary; has-icon: true; icon: Icons.folder-open; clicked => { Shell.open-file(); } }
        }
    }
}

export component AppWindow inherits Window {
    title: Shell.title;
    icon: Icons.logo;
    preferred-width: 1200px;
    preferred-height: 780px;
    min-width: 640px;
    min-height: 420px;
    background: Tokens.surface-base;
    default-font-family: Type.family;
    default-font-size: Type.body;

    // True while the title's file name is being typed over.
    property <bool> renaming;
    changed renaming => { if !self.renaming { keys.focus(); } }
    init => { TipBounds.window-width = self.width; TipBounds.window-height = self.height; }
    changed width => { TipBounds.window-width = self.width; }
    changed height => { TipBounds.window-height = self.height; }

    forward-focus: keys;

    // Under the cast button (its right edge lines up with the button's).
    cast-popup := CastPopup {
        x: root.width - 300px - 132px;
        y: Tokens.bar-height + 4px;
    }
    keys := FocusScope {
        key-pressed(e) => {
            if Shell.key(e.text, e.modifiers.control, e.modifiers.shift, e.modifiers.alt) { return accept; }
            reject
        }

        VerticalLayout {
            // Top bar (hidden in full screen).
            if !Shell.full-screen: Rectangle {
                height: Tokens.bar-height;
                background: Tokens.surface-raised;
                // Left: the tabs. Right: capture, open, settings. The title is centred on the whole bar, over both.
                left-group := HorizontalLayout {
                    x: Tokens.space-2;
                    width: self.preferred-width;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: Tokens.space-1;
                    NavButton { icon: Icons.logo; full-colour: true; label: "Home"; active: Shell.page == "home"; clicked => { Shell.go("home"); } }
                    NavButton { icon: Icons.image; label: "Image"; active: Shell.page == "image"; clicked => { Shell.go("image"); } }
                    NavButton { icon: Icons.music; label: "Audio"; active: Shell.page == "audio"; clicked => { Shell.go("audio"); } }
                    NavButton { icon: Icons.video; label: "Video"; active: Shell.page == "video"; clicked => { Shell.go("video"); } }
                    NavButton { icon: Icons.text; label: "Text"; active: Shell.page == "text"; clicked => { Shell.go("text"); } }
                }
                right-group := HorizontalLayout {
                    x: parent.width - self.width - Tokens.space-2;
                    width: self.preferred-width;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: Tokens.space-1;
                    if Shell.recording: Rectangle {
                        width: rec-row.preferred-width + Tokens.space-4;
                        border-radius: Tokens.radius-control;
                        background: Tokens.record-red.with-alpha(rec-ta.has-hover ? 0.3 : 0.18);
                        rec-row := HorizontalLayout {
                            alignment: center;
                            spacing: Tokens.space-2;
                            Rectangle { width: 10px; Rectangle { width: 10px; height: 10px; border-radius: 5px; background: Tokens.record-red; } }
                            Text { text: "Stop " + Shell.recording-time; color: Tokens.record-red; font-size: Type.body; font-weight: 600; vertical-alignment: center; }
                        }
                        rec-ta := TouchArea { mouse-cursor: pointer; clicked => { Shell.stop-recording(); } }
                    }
                    if Shell.update-ready != "": Rectangle {
                        width: up-text.preferred-width + Tokens.space-4;
                        border-radius: Tokens.radius-control;
                        background: up-ta.has-hover ? Tokens.accent-fill-hover : Tokens.accent-fill;
                        up-text := Text { text: "Restart to update (" + Shell.update-ready + ")"; color: Tokens.text-on-accent; font-size: Type.body; font-weight: 600; }
                        up-ta := TouchArea { mouse-cursor: pointer; clicked => { Shell.apply-update(); } }
                    }
                    IconButton { icon: Icons.scan; label: "Snip (Print Screen)"; clicked => { Shell.snip("region"); } }
                    IconButton {
                        icon: Icons.record;
                        label: Shell.recording ? "Stop recording" : "Record the screen";
                        clicked => { if Shell.recording { Shell.stop-recording(); } else { Shell.record-screen("region"); } }
                    }
                    IconButton { icon: Icons.mic; label: "Voice recorder"; active: Shell.page == "voice"; clicked => { Shell.go("voice"); } }
                    IconButton { icon: Icons.camera; label: "Camera"; active: Shell.page == "camera"; clicked => { Shell.go("camera"); } }
                    cast-btn := IconButton { icon: Icons.cast; label: "Cast to a TV or speaker"; clicked => { Shell.cast(); cast-popup.show(); } }
                    IconButton { icon: Icons.folder-open; label: "Open (Ctrl+O)"; clicked => { Shell.open-file(); } }
                    IconButton { icon: Icons.settings; label: "Settings"; active: Shell.page == "settings"; clicked => { Shell.go("settings"); } }
                    // Close what this tab has open (back to its empty page).
                    if (Shell.page == "image" && Viewer.info-name != "") || (Shell.page == "text" && TextDoc.has-doc) || ((Shell.page == "audio" || Shell.page == "video") && Player.media-title != "" && Player.has-video == (Shell.page == "video")): HorizontalLayout {
                        spacing: Tokens.space-1;
                        Rectangle { width: 9px; Rectangle { width: 1px; height: 20px; background: Tokens.border-subtle; } }
                        IconButton { icon: Icons.x; label: Shell.page == "image" ? "Close the picture" : Shell.page == "text" ? "Close the text" : "Close and stop"; clicked => { Shell.close-tab(); } }
                    }
                }
                // Centred on the window; only as wide as the space both groups leave free on each side.
                // Click the file name to rename it: Enter renames the file, Escape or leaving the box cancels.
                title-box := Rectangle {
                    property <length> room: parent.width - 2 * max(left-group.width, right-group.width) - 2 * Tokens.space-4;
                    width: max(0px, min(title-text.preferred-width, self.room));
                    height: parent.height;
                    x: (parent.width - self.width) / 2;
                    title-text := Text {
                        width: parent.width;
                        height: parent.height;
                        text: Shell.title;
                        color: Tokens.text-muted;
                        font-size: Type.caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                        visible: !root.renaming;
                    }
                    title-ta := TouchArea {
                        mouse-cursor: pointer;
                        enabled: Shell.title-name != "" && !root.renaming;
                        clicked => { root.renaming = true; }
                    }
                    // Edits in place: the same bounds, font and alignment as the title, with a subtle box around it.
                    if root.renaming: Rectangle {
                        x: 0px;
                        y: 0px;
                        width: parent.width;
                        height: parent.height;
                        border-radius: Tokens.radius-control;
                        background: Tokens.surface-sunken;
                        border-width: 1px;
                        border-color: Tokens.border-subtle;
                        rename-input := TextInput {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            text: Shell.title-name;
                            color: Tokens.text-primary;
                            font-size: Type.caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            single-line: true;
                            init => { self.focus(); self.select-all(); }
                            accepted => {
                                root.renaming = false;
                                Shell.rename(self.text);
                            }
                            key-pressed(e) => {
                                if e.text == "\u{1b}" {
                                    root.renaming = false;
                                    return accept;
                                }
                                reject
                            }
                            changed has-focus => {
                                if !self.has-focus { root.renaming = false; }
                            }
                        }
                    }
                }
                Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border-subtle; }
            }

            Rectangle {
                vertical-stretch: 1;
                if Shell.page == "home": HomePage { }
                if Shell.page == "image": ImagePage { }
                if Shell.page == "audio": MediaSlot { want-video: false; }
                if Shell.page == "video": MediaSlot { want-video: true; }
                if Shell.page == "text": TextPage { }
                if Shell.page == "voice": VoicePage { }
                if Shell.page == "camera": CameraPage { }
                if Shell.page == "settings": SettingsPage { }

                if Shell.toast != "": Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: parent.height - self.height - 96px;
                    width: toast-text.preferred-width + 32px;
                    height: 40px;
                    border-radius: 20px;
                    background: Tokens.surface-overlay;
                    border-width: 1px;
                    border-color: Tokens.border-subtle;
                    drop-shadow-blur: 12px;
                    drop-shadow-color: #00000050;
                    toast-text := Text { text: Shell.toast; color: Tokens.text-primary; font-size: Type.body; }
                }
            }
        }

        // The unsaved-changes question (over everything, including the top bar).
        if Shell.confirm-open: ConfirmDialog {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            name: Shell.confirm-name;
            answer(choice) => { Shell.confirm-answer(choice); }
        }
    }
}