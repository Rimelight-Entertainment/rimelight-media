// Small controls drawn from Tokens (the rimelight-space rule: no std-widget colours, no literal colours).
import { ScrollView } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Icons } from "icons.slint";

export struct Choice {
    label: string,
    detail: string,
    selected: bool,
}

// One file in a Recent list. kind: "image", "video", "audio" or "text". index: its position in Shell.recents (what
// Shell.open-recent takes), so every filtered list opens the right file.
export struct RecentItem {
    name: string,
    detail: string,
    kind: string,
    index: int,
}

// The file-type tile Explorer uses for each kind of file: a rounded gradient square with a white glyph (the same artwork
// as src/install.rs). kind: "picture", "video", "music" or "text". tile-size: the side of the square.
export component FileKindTile inherits Rectangle {
    in property <string> kind;
    in property <length> tile-size: 18px;
    property <color> top-colour: root.kind == "picture" ? #7DD3FC : root.kind == "video" ? #C4B5FD : root.kind == "music" ? #FDA4AF : #86EFAC;
    property <color> bottom-colour: root.kind == "picture" ? #0284C7 : root.kind == "video" ? #7C3AED : root.kind == "music" ? #E11D48 : #16A34A;
    property <image> glyph: root.kind == "picture" ? Icons.image : root.kind == "video" ? Icons.video : root.kind == "music" ? Icons.music : Icons.text;
    width: root.tile-size;
    height: root.tile-size;
    border-radius: root.tile-size * 0.22;
    background: @linear-gradient(135deg, root.top-colour 0%, root.bottom-colour 100%);
    Image {
        // The glyph covers about 59% of the square, centred (Explorer's artwork: 150 of 256 px, offset 53).
        x: root.width * 0.207;
        y: root.height * 0.207;
        width: root.width * 0.586;
        height: root.height * 0.586;
        source: root.glyph;
        colorize: #FFFFFF;
    }
}

// An icon button: a fixed square (`size`), the icon centred in it. `enabled: false` dims it and blocks clicks.
export component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> on-stage: false;
    in property <bool> active: false;
    in property <bool> enabled: true;
    in property <length> size: Tokens.control-height;
    in property <length> icon-size: Tokens.icon-medium;
    // The tooltip opens above the button (for a row with a row of controls right below it, so it is not covered).
    in property <bool> tip-above: false;
    in property <color> tint: on-stage ? Tokens.text-on-stage : Tokens.text-primary;
    callback clicked();

    width: size;
    height: size;
    border-radius: Tokens.radius-control;
    background: !enabled ? transparent
        : active ? (on-stage ? #FFFFFF33 : Tokens.surface-pressed)
        : ta.pressed ? (on-stage ? #FFFFFF2A : Tokens.surface-pressed)
        : ta.has-hover ? (on-stage ? Tokens.stage-control-hover : Tokens.surface-hover) : transparent;
    accessible-role: button;
    accessible-label: label;
    accessible-action-default => { if enabled { root.clicked(); } }

    Image {
        source: root.icon;
        width: root.icon-size;
        height: root.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        colorize: root.enabled ? (root.active && !root.on-stage ? Tokens.accent-text : root.tint) : Tokens.text-faint;
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { tip.close(); tip-timer.running = false; root.clicked(); }
        changed has-hover => {
            if self.has-hover && root.enabled {
                tip-timer.running = true;
            } else {
                tip-timer.running = false;
                tip.close();
            }
        }
    }

    // The tooltip is a PopupWindow, so it draws above every sibling (the status bar and the rows below included). It
    // opens after a short hover and closes on leave or click. It is kept inside the window: centred under the button,
    // pushed in from the edges, and flipped above the button when there is no room below it.
    property <length> tip-w: max(40px, root.label.character-count * 7px + 16px);
    property <bool> tip-flip: root.tip-above || root.absolute-position.y + root.height + 30px > TipBounds.window-height;
    property <length> tip-left: max(4px, min(root.absolute-position.x + (root.width - root.tip-w) / 2, TipBounds.window-width - root.tip-w - 4px));

    tip := PopupWindow {
        x: root.tip-left - root.absolute-position.x;
        y: root.tip-flip ? -30px : root.height + 6px;
        width: root.tip-w;
        height: 24px;
        Rectangle {
            background: Tokens.surface-overlay;
            border-radius: Tokens.radius-control;
            border-width: 1px;
            border-color: Tokens.border-subtle;
            Text {
                x: 8px;
                width: parent.width - 16px;
                height: parent.height;
                text: root.label;
                color: Tokens.text-primary;
                font-size: Type.caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    tip-timer := Timer {
        interval: 500ms;
        running: false;
        triggered => {
            self.running = false;
            if root.label != "" && root.enabled { tip.show(); }
        }
    }
}

// The window's size, for placing tooltips (set by the app window).
export global TipBounds {
    in-out property <length> window-width: 1200px;
    in-out property <length> window-height: 780px;
}

export enum ButtonKind { primary, secondary, ghost, danger }

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonKind> kind: secondary;
    in property <bool> enabled: true;
    callback clicked();

    height: Tokens.control-height;
    min-width: layout.preferred-width;
    border-radius: Tokens.radius-control;
    border-width: kind == ButtonKind.secondary ? 1px : 0px;
    border-color: Tokens.border-subtle;
    background: !enabled ? Tokens.surface-sunken
        : kind == ButtonKind.primary ? (ta.has-hover ? Tokens.accent-fill-hover : Tokens.accent-fill)
        : kind == ButtonKind.danger ? (ta.has-hover ? Tokens.status-danger.darker(0.1) : Tokens.status-danger)
        : kind == ButtonKind.secondary ? (ta.pressed ? Tokens.surface-pressed : ta.has-hover ? Tokens.surface-hover : Tokens.surface-raised)
        : (ta.pressed ? Tokens.surface-pressed : ta.has-hover ? Tokens.surface-hover : transparent);
    accessible-role: button;
    accessible-label: text;
    accessible-action-default => { if enabled { root.clicked(); } }

    property <color> fg: !enabled ? Tokens.text-faint
        : (kind == ButtonKind.primary || kind == ButtonKind.danger) ? Tokens.text-on-accent : Tokens.text-primary;

    layout := HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-2;
        alignment: center;
        if root.has-icon: Rectangle {
            width: Tokens.icon-small;
            Image {
                source: root.icon;
                width: Tokens.icon-small;
                height: Tokens.icon-small;
                colorize: root.fg;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Type.body;
            font-weight: kind == ButtonKind.primary ? 600 : 400;
            vertical-alignment: center;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <string> detail;
    callback toggled(bool);

    min-height: 32px;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: checked;
    accessible-label: text;

    HorizontalLayout {
        spacing: Tokens.space-3;
        VerticalLayout {
            alignment: center;
            Text { text: root.text; color: Tokens.text-primary; font-size: Type.body; wrap: word-wrap; }
            if root.detail != "": Text { text: root.detail; color: Tokens.text-muted; font-size: Type.caption; wrap: word-wrap; }
        }
        Rectangle {
            width: 40px;
            Rectangle {
                width: 40px;
                height: 22px;
                border-radius: 11px;
                background: root.checked ? Tokens.accent-fill : Tokens.surface-sunken;
                border-width: root.checked ? 0px : 1px;
                border-color: Tokens.border-strong;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    x: root.checked ? parent.width - 19px : 3px;
                    background: root.checked ? Tokens.text-on-accent : Tokens.border-strong;
                    animate x { duration: Tokens.motion-fast; }
                }
            }
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
}

// A horizontal slider (0..1). Seeks while dragging; `marks` draws trim handles' range when used by the player.
export component Slider inherits Rectangle {
    in-out property <float> value;
    in property <bool> on-stage: true;
    in property <float> range-start: 0;
    in property <float> range-end: 1;
    in property <bool> show-range: false;
    callback changed(float);
    callback released(float);

    // Fills the row's height (at least 20 px); the track and knob are drawn centred, so it lines up with icons and text.
    min-height: 20px;
    preferred-height: 20px;
    accessible-role: slider;
    accessible-value: round(value * 100) + "%";

    property <float> shown: ta.pressed ? clamp(ta.mouse-x / self.width, 0, 1) : value;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 4px;
        border-radius: 2px;
        background: root.on-stage ? #FFFFFF40 : Tokens.surface-pressed;
    }
    if root.show-range: Rectangle {
        x: root.range-start * root.width;
        width: (root.range-end - root.range-start) * root.width;
        y: (parent.height - self.height) / 2;
        height: 8px;
        border-radius: 2px;
        background: #FFC14D80;
    }
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: root.shown * root.width;
        x: 0;
        height: 4px;
        border-radius: 2px;
        background: Tokens.accent-default;
    }
    Rectangle {
        x: root.shown * root.width - self.width / 2;
        y: (parent.height - self.height) / 2;
        width: ta.has-hover || ta.pressed ? 14px : 10px;
        height: self.width;
        border-radius: self.width / 2;
        background: #FFFFFF;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        moved => {
            if self.pressed {
                root.changed(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
        // The value is not assigned here: that would break a binding to it (the zoom slider follows the zoom).
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                root.released(clamp(self.mouse-x / root.width, 0, 1));
            }
        }
    }
}

// A drop-down list of choices (tracks, speeds, tools). The caller places it with x and y.
export component ChoicePopup inherits PopupWindow {
    in property <[Choice]> choices;
    in property <string> heading;
    callback picked(int);

    Rectangle {
        background: Tokens.surface-overlay;
        border-radius: Tokens.radius-r8;
        border-width: 1px;
        border-color: Tokens.border-subtle;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;
        VerticalLayout {
            padding: Tokens.space-1;
            if root.heading != "": Text {
                text: root.heading;
                color: Tokens.text-muted;
                font-size: Type.caption;
                height: 26px;
                vertical-alignment: center;
                x: Tokens.space-2;
            }
            for c[i] in root.choices: Rectangle {
                height: c.detail == "" ? 32px : 44px;
                min-width: 220px;
                border-radius: Tokens.radius-control;
                background: row.has-hover ? Tokens.surface-hover : transparent;
                HorizontalLayout {
                    padding-left: Tokens.space-2;
                    padding-right: Tokens.space-3;
                    spacing: Tokens.space-2;
                    Rectangle {
                        width: Tokens.icon-small;
                        if c.selected: Image {
                            source: @image-url("../assets/icons/check.svg");
                            width: Tokens.icon-small;
                            height: Tokens.icon-small;
                            colorize: Tokens.accent-text;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text { text: c.label; color: Tokens.text-primary; font-size: Type.body; overflow: elide; }
                        if c.detail != "": Text { text: c.detail; color: Tokens.text-muted; font-size: Type.caption; overflow: elide; }
                    }
                }
                row := TouchArea {
                    clicked => { root.picked(i); }
                }
            }
        }
    }
}

export component Card inherits Rectangle {
    background: Tokens.surface-raised;
    border-radius: Tokens.radius-r8;
    border-width: 1px;
    border-color: Tokens.border-subtle;
}

// A big tile on the home page.
export component Tile inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> detail;
    in property <string> keys;
    in property <color> accent: Tokens.accent-default;
    callback clicked();

    // Layouts size a wrapped Text before its width is known, so the detail's lines are estimated from its length and the
    // tile's width (about 7 px a character), and the tile is that tall: the text never spills out of the card.
    property <float> detail-lines: max(1, ceil((root.detail.character-count * 7px) / max(1px, self.width - 2 * Tokens.space-4)));
    min-height: 112px;
    preferred-height: 2 * Tokens.space-4 + 36px + 2 * Tokens.space-1 + 22px + root.detail-lines * 18px + (root.keys != "" ? 20px : 0px);
    border-radius: Tokens.radius-r8;
    background: ta.pressed ? Tokens.surface-pressed : ta.has-hover ? Tokens.surface-hover : Tokens.surface-raised;
    border-width: 1px;
    border-color: ta.has-hover ? Tokens.border-strong : Tokens.border-subtle;
    accessible-role: button;
    accessible-label: title;
    accessible-action-default => { root.clicked(); }

    VerticalLayout {
        padding: Tokens.space-4;
        spacing: Tokens.space-1;
        alignment: start;
        Rectangle {
            width: 36px;
            height: 36px;
            border-radius: Tokens.radius-r8;
            background: root.accent.with-alpha(0.16);
            Image { source: root.icon; width: Tokens.icon-medium; height: Tokens.icon-medium; colorize: root.accent; }
        }
        Rectangle { height: Tokens.space-1; }
        Text { text: root.title; color: Tokens.text-primary; font-size: Type.subheading; font-weight: 600; }
        Text { text: root.detail; color: Tokens.text-muted; font-size: Type.caption; wrap: word-wrap; }
        if root.keys != "": Text { text: root.keys; color: Tokens.text-faint; font-size: Type.caption; }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A modal question over the window: a dimmed overlay and a card with a title, a name and the buttons. The overlay takes
// every click, so nothing behind it works until the question is answered. `answer(0)` Save, `answer(1)` Don't save,
// `answer(2)` Cancel.
export component ConfirmDialog inherits Rectangle {
    in property <string> title: "Save changes?";
    in property <string> name;
    in property <string> detail: "Your changes will be lost if you don't save them.";
    // The first two buttons' labels (answer 0 and 1); an empty second label hides that button. Cancel is answer 2.
    in property <string> primary-text: "Save";
    in property <string> secondary-text: "Don't save";
    callback answer(int);

    background: Tokens.scrim;
    // Swallows the clicks that would reach the page behind.
    TouchArea { }

    Rectangle {
        width: min(420px, parent.width - 2 * Tokens.space-6);
        height: layout.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Tokens.surface-overlay;
        border-radius: Tokens.radius-r8;
        border-width: 1px;
        border-color: Tokens.border-subtle;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000060;

        layout := VerticalLayout {
            padding: Tokens.space-5;
            spacing: Tokens.space-2;
            alignment: start;
            Text { text: root.title; color: Tokens.text-primary; font-size: Type.heading; font-weight: 600; }
            Text { text: root.name; color: Tokens.text-primary; font-size: Type.body; font-weight: 600; overflow: elide; }
            Text { text: root.detail; color: Tokens.text-muted; font-size: Type.body; wrap: word-wrap; }
            Rectangle { height: Tokens.space-3; }
            // Cancel bottom-left; Don't save then Save flush right, with the same gap as Tokens.space-2 elsewhere.
            HorizontalLayout {
                spacing: Tokens.space-2;
                Button { text: "Cancel"; kind: ButtonKind.ghost; clicked => { root.answer(2); } }
                Rectangle { horizontal-stretch: 1; }
                if root.secondary-text != "": Button { text: root.secondary-text; kind: ButtonKind.secondary; clicked => { root.answer(1); } }
                Button { text: root.primary-text; kind: ButtonKind.primary; clicked => { root.answer(0); } }
            }
        }
    }
}

// ---------------------------------------------------------------------------------------------------------------------
// The shared shell pieces. Every tab uses these, so the bars and empty states look the same everywhere.
// Heights come from one token each: Tokens.bar-height (ToolBar), Tokens.action-height (ActionRow), Tokens.status-height
// (StatusBar). Bars pad their rows so a control-height item sits centred in the bar.
// ---------------------------------------------------------------------------------------------------------------------

// The top bar of a tab: icon buttons and text, centred vertically. Children go in order, left to right. Use a
// `Rectangle { horizontal-stretch: 1; }` spacer to push later items to the right. Separate groups with ToolDivider.
export component ToolBar inherits Rectangle {
    height: Tokens.bar-height;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: Tokens.space-2;
        padding-right: Tokens.space-2;
        padding-top: (Tokens.bar-height - Tokens.control-height) / 2;
        padding-bottom: (Tokens.bar-height - Tokens.control-height) / 2;
        spacing: Tokens.space-1;
        alignment: stretch;
        @children
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border-subtle; }
}

// The edit row under the toolbar (crop, resize, trim, find and replace, markup options). The same height everywhere.
// The @children area on the left stretches. When show-confirm is set, the cancel and confirm buttons sit at the far
// right, always flush right. cancel() and confirm() are the buttons' callbacks.
export component ActionRow inherits Rectangle {
    in property <bool> show-confirm: false;
    in property <string> confirm-text: "Apply";
    in property <string> cancel-text: "Cancel";
    in property <bool> confirm-enabled: true;
    callback cancel();
    callback confirm();

    height: Tokens.action-height;
    background: Tokens.surface-base;

    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        padding-top: (Tokens.action-height - Tokens.control-height) / 2;
        padding-bottom: (Tokens.action-height - Tokens.control-height) / 2;
        spacing: Tokens.space-2;
        alignment: stretch;
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Tokens.space-2;
            alignment: start;
            @children
        }
        if root.show-confirm: HorizontalLayout {
            spacing: Tokens.space-2;
            Button { text: root.cancel-text; kind: ButtonKind.secondary; clicked => { root.cancel(); } }
            Button { text: root.confirm-text; kind: ButtonKind.primary; enabled: root.confirm-enabled; clicked => { root.confirm(); } }
        }
    }
    Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border-subtle; }
}

// The bottom bar of a tab: the same height on every tab, always shown (empty left text when nothing is open).
// Left: left-text (metadata joined with " | "), elided. Middle: center-text, when set. Right: @children (icon buttons
// and short controls, vertically centred).
// The Ctrl+? shortcut list: `open` is true while it is shown. Every status bar sets it; the app window shows the list.
export global ShortcutsCtl {
    in-out property <bool> open;
}

export component StatusBar inherits Rectangle {
    in property <string> left-text;
    in property <string> center-text;

    height: Tokens.status-height;
    background: Tokens.surface-raised;

    HorizontalLayout {
        padding-left: Tokens.space-2;
        // Room for the shortcuts button at the right edge (see below).
        padding-right: Tokens.space-2 + 28px + Tokens.space-3;
        padding-top: (Tokens.status-height - 28px) / 2;
        padding-bottom: (Tokens.status-height - 28px) / 2;
        spacing: Tokens.space-3;
        alignment: stretch;
        // With no left-text, the page lays out the whole bar itself in @children (e.g. buttons on the left too).
        if root.left-text != "": Text {
            text: root.left-text;
            color: Tokens.text-muted;
            font-size: Type.caption;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.center-text != "": Text {
            text: root.center-text;
            color: Tokens.text-muted;
            font-size: Type.caption;
            vertical-alignment: center;
            horizontal-alignment: center;
            min-width: 48px;
        }
        HorizontalLayout {
            spacing: Tokens.space-3;
            alignment: root.left-text != "" ? LayoutAlignment.end : LayoutAlignment.stretch;
            horizontal-stretch: root.left-text != "" ? 0 : 1;
            @children
        }
    }
    // Rightmost on every page: opens the Ctrl+? shortcut list. Placed at the right edge; the row leaves room for it.
    IconButton {
        x: root.width - self.width - Tokens.space-2;
        y: (root.height - self.height) / 2;
        size: 28px;
        icon-size: Tokens.icon-small;
        icon: Icons.keyboard;
        label: "Keyboard shortcuts (Ctrl+?)";
        clicked => { ShortcutsCtl.open = true; }
    }
    Rectangle { y: 0px; height: 1px; background: Tokens.border-subtle; }
}

// A vertical 1px divider between groups in a ToolBar or ActionRow. Never at the end of a row.
export component ToolDivider inherits Rectangle {
    width: 9px;
    height: Tokens.control-height;
    Rectangle {
        x: 4px;
        width: 1px;
        height: 20px;
        y: (parent.height - self.height) / 2;
        background: Tokens.border-subtle;
    }
}

// One row of a Recent list: the file-type icon, the name and the folder.
export component RecentRow inherits Rectangle {
    in property <RecentItem> item;
    callback clicked();
    height: Tokens.row-height;
    border-radius: Tokens.radius-control;
    background: ta.has-hover ? Tokens.surface-hover : transparent;
    HorizontalLayout {
        padding-left: Tokens.space-3;
        padding-right: Tokens.space-3;
        spacing: Tokens.space-3;
        alignment: start;
        // The same Explorer tile as the empty pages, per file kind.
        Rectangle {
            width: Tokens.icon-medium;
            FileKindTile {
                kind: root.item.kind == "image" ? "picture" : root.item.kind == "audio" ? "music" : root.item.kind;
                tile-size: Tokens.icon-medium;
                y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text { text: root.item.name; color: Tokens.text-primary; font-size: Type.body; horizontal-alignment: left; overflow: elide; }
            Text { text: root.item.detail; color: Tokens.text-muted; font-size: Type.caption; horizontal-alignment: left; overflow: elide; }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The empty state of a tab: a centred column (max 560 px wide) with the big icon in the file-type colour, the title,
// the supported file types, the Open button and, when new-text is set, the New button beside it. The tab's Recent list
// (already filtered to its kind by the host) sits under the buttons, with a Clear button that clears that kind.
// on-stage: the light-on-dark look for the picture and video stage. The host supplies the background.
// The Recent list, the same on the home page and every empty tab: a header with Clear (only when there are files), then
// a card that always shows: the rows, or a line saying the list is empty.
export component RecentBlock inherits VerticalLayout {
    in property <[RecentItem]> recents;
    in property <color> ink: Tokens.text-primary;
    in property <color> muted: Tokens.text-muted;
    callback open-recent(int);
    callback clear-recents();

    spacing: Tokens.space-2;
    // A fixed height: the header is the same whether or not Clear is shown, so only the list below changes.
    HorizontalLayout {
        height: Tokens.control-height;
        Text { text: "Recent"; color: root.ink; font-size: Type.subheading; font-weight: 600; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        if root.recents.length > 0: Button { text: "Clear"; kind: ButtonKind.ghost; clicked => { root.clear-recents(); } }
    }
    Card {
        VerticalLayout {
            padding: Tokens.space-1;
            if root.recents.length == 0: Text {
                text: "Files you open show up here.";
                color: root.muted;
                font-size: Type.body;
                horizontal-alignment: center;
                vertical-alignment: center;
                height: Tokens.row-height;
            }
            for r[i] in root.recents: RecentRow {
                item: r;
                clicked => { root.open-recent(r.index); }
            }
        }
    }
}

export component EmptyState inherits Rectangle {
    in property <image> icon;
    in property <color> icon-colour: Tokens.text-muted;
    // The icon keeps its own colours (the app icon); otherwise it is tinted with icon-colour.
    in property <bool> icon-full-colour: false;
    // A file kind ("picture", "video", "music" or "text"): shows that kind's Explorer tile instead of `icon`.
    in property <string> icon-kind;
    in property <string> title;
    // The types the open button takes, e.g. ".png, .jpg and more". A "Supported file types:" label sits above them.
    in property <string> formats;
    // A sentence shown in place of the types (the home page). Empty: the types are shown.
    in property <string> hint;
    in property <string> open-text: "Open a file";
    // Empty: no new-file button (audio, for example).
    in property <string> new-text: "";
    in property <image> new-icon;
    in property <[RecentItem]> recents;
    in property <bool> on-stage: false;
    callback open();
    callback new-file();
    callback open-recent(int);
    callback clear-recents();

    property <color> ink: root.on-stage ? Tokens.text-on-stage : Tokens.text-primary;
    property <color> muted: root.on-stage ? #9AA4B2 : Tokens.text-muted;

    ScrollView {
        VerticalLayout {
            // Every empty tab and the home page use this one layout: the top section starts at the same height and has
            // fixed-height rows, so nothing moves when the text changes. The Recent list starts below it, the same place
            // everywhere. The list scrolls.
            padding-top: Tokens.space-8;
            padding-bottom: Tokens.space-6;
            padding-left: Tokens.space-6;
            padding-right: Tokens.space-6;
            alignment: start;
            HorizontalLayout {
                alignment: center;
                VerticalLayout {
                    width: min(640px, root.width - 2 * Tokens.space-6);
                    alignment: start;
                    VerticalLayout {
                        height: Tokens.top-section;
                        alignment: start;
                        spacing: Tokens.space-3;
                        HorizontalLayout {
                            height: 56px;
                            alignment: center;
                            if root.icon-kind != "": FileKindTile { kind: root.icon-kind; tile-size: 56px; }
                            if root.icon-kind == "" && !root.icon-full-colour: Image { source: root.icon; width: 56px; height: 56px; colorize: root.icon-colour; }
                            if root.icon-kind == "" && root.icon-full-colour: Image { source: root.icon; width: 56px; height: 56px; }
                        }
                        Text {
                            text: root.title;
                            color: root.ink;
                            font-size: Type.title;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            height: 40px;
                        }
                        // Three lines for the text, whatever the list holds, so the buttons never move.
                        VerticalLayout {
                            height: 88px;
                            alignment: start;
                            spacing: Tokens.space-1;
                            if root.hint == "": Text { text: "Supported file types:"; color: root.muted; font-size: Type.body; horizontal-alignment: center; height: 20px; }
                            if root.hint == "": Text { text: root.formats; color: root.muted; font-size: Type.body; horizontal-alignment: center; wrap: word-wrap; vertical-alignment: top; }
                            if root.hint != "": Text { text: root.hint; color: root.muted; font-size: Type.body; horizontal-alignment: center; wrap: word-wrap; vertical-alignment: top; }
                        }
                        HorizontalLayout {
                            height: Tokens.control-height;
                            alignment: center;
                            spacing: Tokens.space-2;
                            Button {
                                text: root.open-text;
                                kind: ButtonKind.primary;
                                has-icon: true;
                                icon: Icons.folder-open;
                                clicked => { root.open(); }
                            }
                            if root.new-text != "": Button {
                                text: root.new-text;
                                kind: ButtonKind.secondary;
                                has-icon: true;
                                icon: root.new-icon;
                                clicked => { root.new-file(); }
                            }
                        }
                    }
                    VerticalLayout {
                        padding-top: Tokens.space-5;
                        RecentBlock {
                            recents: root.recents;
                            ink: root.ink;
                            muted: root.muted;
                            open-recent(i) => { root.open-recent(i); }
                            clear-recents => { root.clear-recents(); }
                        }
                    }
                }
            }
        }
    }
}
