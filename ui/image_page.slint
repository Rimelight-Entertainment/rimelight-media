// The picture viewer and editor: zoom and pan, folder browsing, crop, rotate, flip, resize and markup.
import { LineEdit, ScrollView } from "std-widgets.slint";
import { Tokens, Type } from "tokens.slint";
import { Icons } from "icons.slint";
import { IconButton, Button, ButtonKind, Card, Toggle, Slider } from "widgets.slint";
import { Viewer, Shell } from "state.slint";

component Divider inherits Rectangle {
    width: 9px;
    height: Tokens.control-height;
    Rectangle {
        width: 1px;
        height: 20px;
        background: Tokens.border-subtle;
    }
}

component Swatch inherits Rectangle {
    in property <color> colour;
    width: 26px;
    height: Tokens.control-height;
    Rectangle {
        width: 22px;
        height: 22px;
        border-radius: 11px;
        background: root.colour;
        border-width: Viewer.ink == root.colour ? 3px : 1px;
        border-color: Viewer.ink == root.colour ? Tokens.accent-default : Tokens.border-subtle;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { Viewer.pick-colour(root.colour); }
    }
}

component Handle inherits Rectangle {
    callback drag(length, length);
    callback start();
    in property <MouseCursor> cursor: move;
    width: 16px;
    height: 16px;
    border-radius: 3px;
    background: #FFFFFF;
    border-width: 1px;
    border-color: #00000080;
    ta := TouchArea {
        mouse-cursor: root.cursor;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down { root.start(); }
        }
        moved => {
            if self.pressed { root.drag(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y); }
        }
    }
}

export component ImagePage inherits Rectangle {
    background: Tokens.stage;
    // The custom colour box's text.
    property <string> hex-text;

    // The scale showing now, and zooming around the middle of the stage.
    property <float> cur-scale: Viewer.fit ? Viewer.fit-scale : Viewer.scale;
    function zoom-to(s: float) {
        let new = clamp(s, 0.02, 40);
        let ratio = new / root.cur-scale;
        Viewer.pan-x = Viewer.fit ? 0px : Viewer.pan-x * ratio;
        Viewer.pan-y = Viewer.fit ? 0px : Viewer.pan-y * ratio;
        Viewer.scale = new;
        Viewer.fit = false;
    }

    VerticalLayout {
        // Main toolbar: file actions on the left, edit tools on the right (hidden in full screen).
        if !Shell.full-screen: Rectangle {
            height: Tokens.bar-height;
            background: Tokens.surface-raised;
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Tokens.space-1;
                IconButton { icon: Icons.save; label: "Save (Ctrl+S)"; enabled: Viewer.dirty || Viewer.canvas; clicked => { Viewer.save(); } }
                IconButton { icon: Icons.save; label: "Save as (Ctrl+Shift+S)"; clicked => { Viewer.save-as(); } }
                IconButton { icon: Icons.copy; label: "Copy (Ctrl+C)"; clicked => { Viewer.copy(); } }
                IconButton { icon: Icons.printer; label: "Print (Ctrl+P)"; clicked => { Viewer.print(); } }
                IconButton { icon: Icons.share; label: "Share"; enabled: Viewer.can-share; clicked => { Viewer.share(); } }
                IconButton { icon: Icons.folder-open; label: "Show in folder"; enabled: Viewer.can-share; clicked => { Viewer.open-folder(); } }
                Divider { }
                IconButton { icon: Icons.undo; label: "Undo (Ctrl+Z)"; enabled: Viewer.can-undo; clicked => { Viewer.undo(); } }
                IconButton { icon: Icons.redo; label: "Redo (Ctrl+Y)"; enabled: Viewer.can-redo; clicked => { Viewer.redo(); } }
                IconButton { icon: Icons.x; label: "Discard changes"; enabled: Viewer.dirty; clicked => { Viewer.revert(); } }
                Rectangle { horizontal-stretch: 1; }
                IconButton { icon: Icons.rotate; label: "Rotate (R)"; enabled: !Viewer.comparing; clicked => { Viewer.rotate(); } }
                IconButton { icon: Icons.flip-h; label: "Flip left-right"; enabled: !Viewer.comparing; clicked => { Viewer.flip(true); } }
                IconButton { icon: Icons.flip-v; label: "Flip upside down"; enabled: !Viewer.comparing; clicked => { Viewer.flip(false); } }
                IconButton { icon: Icons.crop; label: "Crop (C)"; enabled: !Viewer.comparing; active: Viewer.mode == "crop"; clicked => { Viewer.set-mode(Viewer.mode == "crop" ? "" : "crop"); } }
                IconButton { icon: Icons.pen; label: "Draw (M)"; enabled: !Viewer.comparing; active: Viewer.mode == "markup"; clicked => { Viewer.set-mode(Viewer.mode == "markup" ? "" : "markup"); } }
                IconButton { icon: Icons.resize; label: "Resize"; enabled: !Viewer.comparing; active: Viewer.mode == "resize"; clicked => { Viewer.set-mode(Viewer.mode == "resize" ? "" : "resize"); } }
                Divider { }
                IconButton { icon: Icons.trash; label: "Delete (Del)"; clicked => { Viewer.delete-current(); } }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border-subtle; }
        }

        // Second bar: the edit in progress (crop, draw, resize), under the main one.
        if Viewer.mode != "" && !Shell.full-screen: Rectangle {
            // Markup takes two rows: the tools, then the colours and the selection actions.
            height: Viewer.mode == "markup" ? Tokens.bar-height * 2 : Tokens.bar-height;
            background: Tokens.surface-base;
            HorizontalLayout {
                padding-left: Tokens.space-2;
                padding-right: Tokens.space-2;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: Tokens.space-1;
                if Viewer.mode == "crop": HorizontalLayout {
                    spacing: Tokens.space-1;
                    Text { text: "Crop"; color: Tokens.text-primary; font-size: Type.subheading; font-weight: 600; vertical-alignment: center; }
                    Rectangle { width: Tokens.space-3; }
                    Button { text: "Free"; kind: Viewer.crop-aspect == 0 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { Viewer.crop-preset(0); } }
                    Button { text: "Original"; kind: ButtonKind.ghost; clicked => { Viewer.crop-preset(-1); } }
                    Button { text: "Square"; kind: Viewer.crop-aspect == 1 ? ButtonKind.secondary : ButtonKind.ghost; clicked => { Viewer.crop-preset(1); } }
                    Button { text: "4:3"; kind: ButtonKind.ghost; clicked => { Viewer.crop-preset(4 / 3); } }
                    Button { text: "3:2"; kind: ButtonKind.ghost; clicked => { Viewer.crop-preset(3 / 2); } }
                    Button { text: "16:9"; kind: ButtonKind.ghost; clicked => { Viewer.crop-preset(16 / 9); } }
                    Button { text: "9:16"; kind: ButtonKind.ghost; clicked => { Viewer.crop-preset(9 / 16); } }
                    Text {
                        text: round(Viewer.crop-w * Viewer.pic-w) + " × " + round(Viewer.crop-h * Viewer.pic-h);
                        color: Tokens.text-muted;
                        font-size: Type.caption;
                        vertical-alignment: center;
                        width: 100px;
                        horizontal-alignment: center;
                    }
                    Button { text: "Cancel"; clicked => { Viewer.set-mode(""); } }
                    Button { text: "Apply crop"; kind: ButtonKind.primary; clicked => { Viewer.apply-crop(); } }
                }

                if Viewer.mode == "markup": VerticalLayout {
                    spacing: Tokens.space-1;
                    alignment: center;
                    HorizontalLayout {
                        spacing: Tokens.space-1;
                        IconButton { icon: Icons.pen; label: "Pen"; active: Viewer.tool == 0; clicked => { Viewer.set-tool(0); } }
                        IconButton { icon: Icons.highlighter; label: "Highlighter"; active: Viewer.tool == 1; clicked => { Viewer.set-tool(1); } }
                        IconButton { icon: Icons.arrow; label: "Arrow"; active: Viewer.tool == 2; clicked => { Viewer.set-tool(2); } }
                        IconButton { icon: Icons.square; label: "Box"; active: Viewer.tool == 3; clicked => { Viewer.set-tool(3); } }
                        IconButton { icon: Icons.circle; label: "Ellipse"; active: Viewer.tool == 6; clicked => { Viewer.set-tool(6); } }
                        IconButton { icon: Icons.line; label: "Line"; active: Viewer.tool == 7; clicked => { Viewer.set-tool(7); } }
                        IconButton { icon: Icons.text; label: "Text"; active: Viewer.tool == 4; clicked => { Viewer.set-tool(4); } }
                        IconButton { icon: Icons.eraser; label: "Eraser (click a mark)"; active: Viewer.tool == 5; clicked => { Viewer.set-tool(5); } }
                        Divider { }
                        IconButton { icon: Icons.brush; label: "Fill the box or ellipse with the colour"; active: Viewer.fill-shape; enabled: Viewer.tool == 3 || Viewer.tool == 6; clicked => { Viewer.fill-shape = !Viewer.fill-shape; } }
                        Divider { }
                        IconButton { icon: Icons.pipette; label: "Eyedropper (take a colour from the picture)"; active: Viewer.tool == 8; clicked => { Viewer.set-tool(8); } }
                        IconButton { icon: Icons.paint-bucket; label: "Paint bucket (fill an area)"; active: Viewer.tool == 9; clicked => { Viewer.set-tool(9); } }
                        IconButton { icon: Icons.select-rect; label: "Rectangle select"; active: Viewer.tool == 10; clicked => { Viewer.set-tool(10); } }
                        IconButton { icon: Icons.move; label: "Move (click a mark, then drag it)"; active: Viewer.tool == 11; clicked => { Viewer.set-tool(11); } }
                        Divider { }
                        // Thickness, 1 to 40 px.
                        Slider {
                            width: 120px;
                            on-stage: false;
                            value: (Viewer.ink-width - 1) / 39;
                            changed(v) => { Viewer.ink-width = 1 + v * 39; }
                            released(v) => { Viewer.ink-width = 1 + v * 39; }
                        }
                        Text { text: round(Viewer.ink-width) + " px"; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; width: 40px; }
                        Divider { }
                        IconButton { icon: Icons.trash; label: "Clear all marks"; enabled: Viewer.marks.length > 0; clicked => { Viewer.clear-marks(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Button { text: "Cancel"; clicked => { Viewer.set-mode(""); } }
                        Button { text: "Done"; kind: ButtonKind.primary; clicked => { Viewer.apply-marks(); } }
                    }
                    HorizontalLayout {
                        spacing: Tokens.space-1;
                        // Twelve colours, the six most recent, and a hex box for any other.
                        for c in [#101014, #FFFFFF, #8A8A93, #E5484D, #F76B15, #FFC14D, #30A46C, #3FD6B8, #0D7FFF, #8E4EC6, #E93D82, #7C4A2D]: Swatch { colour: c; }
                        Divider { }
                        for c in Viewer.recent-colours: Swatch { colour: c; }
                        Divider { }
                        LineEdit {
                            width: 110px;
                            placeholder-text: "#RRGGBB";
                            text <=> root.hex-text;
                            accepted => { Viewer.pick-hex(root.hex-text); }
                        }
                        Button { text: "Use"; clicked => { Viewer.pick-hex(root.hex-text); } }
                        Divider { }
                        if Viewer.has-sel: HorizontalLayout {
                            spacing: Tokens.space-1;
                            Button { text: "Copy"; clicked => { Viewer.copy(); } }
                            Button { text: "Cut"; clicked => { Viewer.cut-selection(); } }
                            Button { text: "Crop to selection"; clicked => { Viewer.crop-selection(); } }
                            Button { text: "Delete"; clicked => { Viewer.delete-selection(); } }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                if Viewer.mode == "resize": HorizontalLayout {
                    spacing: Tokens.space-2;
                    Text { text: "Resize"; color: Tokens.text-primary; font-size: Type.subheading; font-weight: 600; vertical-alignment: center; }
                    LineEdit {
                        width: 90px;
                        text <=> Viewer.resize-w;
                        input-type: number;
                        edited => { Viewer.resize-edited(true); }
                    }
                    Text { text: "×"; color: Tokens.text-muted; vertical-alignment: center; }
                    LineEdit {
                        width: 90px;
                        text <=> Viewer.resize-h;
                        input-type: number;
                        edited => { Viewer.resize-edited(false); }
                    }
                    Text { text: "pixels"; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; }
                    Toggle { width: 200px; text: "Keep proportions"; checked <=> Viewer.resize-keep; }
                    Button { text: "Cancel"; clicked => { Viewer.set-mode(""); } }
                    Button { text: "Apply"; kind: ButtonKind.primary; clicked => { Viewer.apply-resize(); } }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Rectangle { y: parent.height - 1px; height: 1px; background: Tokens.border-subtle; }
        }

        HorizontalLayout {
            // Details: on the left of the picture.
            if Viewer.show-info: Rectangle {
                width: 280px;
                background: Tokens.surface-raised;
                border-width: 1px;
                border-color: Tokens.border-subtle;
                VerticalLayout {
                    padding: Tokens.space-4;
                    spacing: Tokens.space-2;
                    alignment: start;
                    Text { text: "Details"; color: Tokens.text-primary; font-size: Type.subheading; font-weight: 600; }
                    Text { text: Viewer.info-name; color: Tokens.text-primary; font-size: Type.body; wrap: word-wrap; }
                    Text { text: Viewer.info-detail; color: Tokens.text-muted; font-size: Type.caption; wrap: word-wrap; }
                }
            }

            stage := Rectangle {
                background: Tokens.stage;
                clip: true;

                property <float> fit-scale: min((self.width - 48px) / 1px / Viewer.pic-w, (self.height - 48px) / 1px / Viewer.pic-h, 1.0);
                init => { Viewer.fit-scale = self.fit-scale; }
                changed fit-scale => { Viewer.fit-scale = self.fit-scale; }
                property <float> s: Viewer.fit || Viewer.mode != "" ? fit-scale : Viewer.scale;
                property <length> pw: Viewer.pic-w * s * 1px;
                property <length> ph: Viewer.pic-h * s * 1px;
                property <length> px: (self.width - pw) / 2 + (Viewer.fit || Viewer.mode != "" ? 0px : Viewer.pan-x);
                property <length> py: (self.height - ph) / 2 + (Viewer.fit || Viewer.mode != "" ? 0px : Viewer.pan-y);

                // Pan with a drag, zoom with the wheel around the pointer, double-click for 100 % / fit.
                pan := TouchArea {
                    property <length> start-x;
                    property <length> start-y;
                    mouse-cursor: Viewer.fit ? default : (self.pressed ? grabbing : grab);
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.down {
                            self.start-x = Viewer.pan-x;
                            self.start-y = Viewer.pan-y;
                        }
                    }
                    moved => {
                        if self.pressed && !Viewer.fit {
                            Viewer.pan-x = self.start-x + (self.mouse-x - self.pressed-x);
                            Viewer.pan-y = self.start-y + (self.mouse-y - self.pressed-y);
                        }
                    }
                    double-clicked => {
                        if Viewer.fit {
                            Viewer.scale = 1;
                            Viewer.pan-x = 0;
                            Viewer.pan-y = 0;
                            Viewer.fit = false;
                        } else {
                            Viewer.fit = true;
                        }
                    }
                    scroll-event(e) => {
                        if Viewer.mode != "" { return reject; }
                        let old = stage.s;
                        let new = clamp(old * (e.delta-y > 0 ? 1.2 : 1 / 1.2), 0.02, 40);
                        let u = (self.mouse-x - stage.px) / old;
                        let v = (self.mouse-y - stage.py) / old;
                        Viewer.pan-x = self.mouse-x - u * new - (stage.width - Viewer.pic-w * new * 1px) / 2;
                        Viewer.pan-y = self.mouse-y - v * new - (stage.height - Viewer.pic-h * new * 1px) / 2;
                        Viewer.scale = new;
                        Viewer.fit = false;
                        return accept;
                    }
                }

                Image {
                    x: stage.px;
                    y: stage.py;
                    width: stage.pw;
                    height: stage.ph;
                    source: Viewer.picture;
                    image-rendering: stage.s > 2 ? pixelated : smooth;
                }

                // Marks, drawn over the picture in picture pixels.
                Rectangle {
                    x: stage.px;
                    y: stage.py;
                    width: stage.pw;
                    height: stage.ph;
                    clip: true;
                    for m in Viewer.marks: Rectangle {
                        if m.kind != 4 && m.kind != 5: Path {
                            width: stage.pw;
                            height: stage.ph;
                            viewbox-x: 0;
                            viewbox-y: 0;
                            viewbox-width: Viewer.pic-w;
                            viewbox-height: Viewer.pic-h;
                            commands: m.commands;
                            stroke: m.colour;
                            stroke-width: m.width * stage.s * 1px;
                            stroke-line-cap: round;
                            fill: m.filled ? m.colour : transparent;
                        }
                        if m.kind == 4: Text {
                            x: m.x * stage.s * 1px;
                            y: m.y * stage.s * 1px;
                            text: m.text;
                            color: m.colour;
                            font-size: max(1px, m.width * stage.s * 1px);
                            font-weight: 600;
                        }
                        // A picture mark: its pixels in its rectangle.
                        if m.kind == 5: Image {
                            x: m.x * stage.s * 1px;
                            y: m.y * stage.s * 1px;
                            width: m.w * stage.s * 1px;
                            height: m.h * stage.s * 1px;
                            source: m.picture;
                            image-fit: fill;
                        }
                    }
                }

                // The rectangle selection, and the box of the picked mark (its corner handle resizes a picture or a shape).
                if Viewer.has-sel: Rectangle {
                    x: stage.px + Viewer.sel-x * stage.s * 1px;
                    y: stage.py + Viewer.sel-y * stage.s * 1px;
                    width: max(1px, Viewer.sel-w * stage.s * 1px);
                    height: max(1px, Viewer.sel-h * stage.s * 1px);
                    border-width: 1px;
                    border-color: #000000;
                    Rectangle {
                        x: -1px;
                        y: -1px;
                        width: parent.width + 2px;
                        height: parent.height + 2px;
                        border-width: 1px;
                        border-color: #FFFFFFC0;
                    }
                }
                if Viewer.has-box: Rectangle {
                    x: stage.px + Viewer.box-x * stage.s * 1px;
                    y: stage.py + Viewer.box-y * stage.s * 1px;
                    width: max(2px, Viewer.box-w * stage.s * 1px);
                    height: max(2px, Viewer.box-h * stage.s * 1px);
                    border-width: 1px;
                    border-color: Tokens.accent-default;
                    Rectangle {
                        x: parent.width - 4px;
                        y: parent.height - 4px;
                        width: 8px;
                        height: 8px;
                        background: #FFFFFF;
                        border-width: 1px;
                        border-color: Tokens.accent-default;
                    }
                }

                // Markup input.
                if Viewer.mode == "markup": TouchArea {
                    x: stage.px;
                    y: stage.py;
                    width: stage.pw;
                    height: stage.ph;
                    mouse-cursor: crosshair;
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left {
                            if e.kind == PointerEventKind.down {
                                Viewer.mark-begin(self.mouse-x / stage.s / 1px, self.mouse-y / stage.s / 1px);
                            } else if e.kind == PointerEventKind.up {
                                Viewer.mark-end();
                            }
                        }
                    }
                    moved => {
                        if self.pressed { Viewer.mark-move(self.mouse-x / stage.s / 1px, self.mouse-y / stage.s / 1px); }
                    }
                }
                if Viewer.mode == "markup" && Viewer.text-x >= 0: Rectangle {
                    x: stage.px + Viewer.text-x * stage.s * 1px;
                    y: stage.py + Viewer.text-y * stage.s * 1px;
                    width: max(160px, ti.preferred-width + 16px);
                    height: ti.preferred-height + 8px;
                    background: #00000040;
                    border-width: 1px;
                    border-color: Tokens.accent-default;
                    // Clicking elsewhere, Enter or Escape commits the text as a mark (Rust does it).
                    changed x => { ti.focus(); }
                    ti := TextInput {
                        x: 4px;
                        color: Viewer.ink;
                        font-size: max(12px, Viewer.ink-width * 4 * stage.s * 1px);
                        font-weight: 600;
                        single-line: true;
                        text <=> Viewer.pending-text;
                        init => { self.focus(); }
                        accepted => { Viewer.commit-text(); }
                        changed has-focus => {
                            if !self.has-focus { Viewer.commit-text(); }
                        }
                        key-pressed(e) => {
                            if e.text == "\u{1b}" {
                                Viewer.commit-text();
                                return accept;
                            }
                            reject
                        }
                    }
                }

                // Crop box with its handles.
                if Viewer.mode == "crop": Rectangle {
                    x: stage.px;
                    y: stage.py;
                    width: stage.pw;
                    height: stage.ph;
                    property <float> sx;
                    property <float> sy;
                    property <float> sw;
                    property <float> sh;
                    property <float> ratio: Viewer.crop-aspect == 0 ? 0 : self.width / self.height / Viewer.crop-aspect;
                    function remember() {
                        self.sx = Viewer.crop-x;
                        self.sy = Viewer.crop-y;
                        self.sw = Viewer.crop-w;
                        self.sh = Viewer.crop-h;
                    }
                    // Moves a corner by (dx, dy) fractions of the picture, keeping the opposite corner still.
                    function corner(left: bool, top: bool, dx: float, dy: float) {
                        let right-edge = self.sx + self.sw;
                        let bottom-edge = self.sy + self.sh;
                        let nx = left ? clamp(self.sx + dx, 0, right-edge - 0.02) : self.sx;
                        let nw = left ? right-edge - nx : clamp(self.sw + dx, 0.02, 1 - self.sx);
                        let ny = top ? clamp(self.sy + dy, 0, bottom-edge - 0.02) : self.sy;
                        let nh = top ? bottom-edge - ny : clamp(self.sh + dy, 0.02, 1 - self.sy);
                        // With a fixed shape the height follows the width, and both shrink to stay inside.
                        let room = top ? bottom-edge : 1 - self.sy;
                        let fh = min(nw * self.ratio, room);
                        let fw = self.ratio > 0 ? fh / self.ratio : nw;
                        Viewer.crop-x = self.ratio > 0 ? (left ? right-edge - fw : self.sx) : nx;
                        Viewer.crop-y = self.ratio > 0 ? (top ? bottom-edge - fh : self.sy) : ny;
                        Viewer.crop-w = fw;
                        Viewer.crop-h = self.ratio > 0 ? fh : nh;
                    }

                    property <length> cx: Viewer.crop-x * self.width;
                    property <length> cy: Viewer.crop-y * self.height;
                    property <length> cw: Viewer.crop-w * self.width;
                    property <length> ch: Viewer.crop-h * self.height;

                    // Dim outside the box.
                    Rectangle { x: 0; y: 0; width: parent.width; height: parent.cy; background: Tokens.scrim; }
                    Rectangle { x: 0; y: parent.cy + parent.ch; width: parent.width; height: parent.height - parent.cy - parent.ch; background: Tokens.scrim; }
                    Rectangle { x: 0; y: parent.cy; width: parent.cx; height: parent.ch; background: Tokens.scrim; }
                    Rectangle { x: parent.cx + parent.cw; y: parent.cy; width: parent.width - parent.cx - parent.cw; height: parent.ch; background: Tokens.scrim; }

                    Rectangle {
                        x: parent.cx;
                        y: parent.cy;
                        width: parent.cw;
                        height: parent.ch;
                        border-width: 2px;
                        border-color: #FFFFFF;
                        // Rule of thirds.
                        Rectangle { x: parent.width / 3; width: 1px; background: #FFFFFF60; }
                        Rectangle { x: parent.width * 2 / 3; width: 1px; background: #FFFFFF60; }
                        Rectangle { y: parent.height / 3; height: 1px; background: #FFFFFF60; }
                        Rectangle { y: parent.height * 2 / 3; height: 1px; background: #FFFFFF60; }
                        body := TouchArea {
                            mouse-cursor: move;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.down {
                                    remember();
                                }
                            }
                            moved => {
                                if self.pressed {
                                    Viewer.crop-x = clamp(sx + (self.mouse-x - self.pressed-x) / stage.pw, 0, 1 - sw);
                                    Viewer.crop-y = clamp(sy + (self.mouse-y - self.pressed-y) / stage.ph, 0, 1 - sh);
                                }
                            }
                        }
                    }
                    Handle {
                        x: parent.cx - 8px;
                        y: parent.cy - 8px;
                        cursor: nwse-resize;
                        start => { remember(); }
                        drag(dx, dy) => { corner(true, true, dx / stage.pw, dy / stage.ph); }
                    }
                    Handle {
                        x: parent.cx + parent.cw - 8px;
                        y: parent.cy - 8px;
                        cursor: nesw-resize;
                        start => { remember(); }
                        drag(dx, dy) => { corner(false, true, dx / stage.pw, dy / stage.ph); }
                    }
                    Handle {
                        x: parent.cx - 8px;
                        y: parent.cy + parent.ch - 8px;
                        cursor: nesw-resize;
                        start => { remember(); }
                        drag(dx, dy) => { corner(true, false, dx / stage.pw, dy / stage.ph); }
                    }
                    Handle {
                        x: parent.cx + parent.cw - 8px;
                        y: parent.cy + parent.ch - 8px;
                        cursor: nwse-resize;
                        start => { remember(); }
                        drag(dx, dy) => { corner(false, false, dx / stage.pw, dy / stage.ph); }
                    }
                }

                // Resize: a box at the new size over the picture. Its handles drag it, and the width and height fields follow.
                if Viewer.mode == "resize": rz := Rectangle {
                    x: stage.px;
                    y: stage.py;
                    width: stage.pw;
                    height: stage.ph;
                    property <float> sw;
                    property <float> sh;
                    property <float> bw: max(1, Viewer.resize-w.to-float());
                    property <float> bh: max(1, Viewer.resize-h.to-float());
                    // Sets the new size; with the proportions lock the other side follows (from the height when from-height).
                    function set-size(w: float, h: float, from-height: bool) {
                        let nw = Viewer.resize-keep && from-height ? h * Viewer.pic-w / Viewer.pic-h : w;
                        let nh = Viewer.resize-keep && !from-height ? w * Viewer.pic-h / Viewer.pic-w : h;
                        Viewer.resize-w = round(clamp(nw, 1, 30000)) + "";
                        Viewer.resize-h = round(clamp(nh, 1, 30000)) + "";
                    }
                    box := Rectangle {
                        x: 0;
                        y: 0;
                        width: rz.bw * rz.width / Viewer.pic-w;
                        height: rz.bh * rz.height / Viewer.pic-h;
                        border-width: 2px;
                        border-color: #FFFFFF;
                        Handle {
                            x: parent.width - 8px;
                            y: parent.height - 8px;
                            cursor: nwse-resize;
                            start => { rz.sw = rz.bw; rz.sh = rz.bh; }
                            drag(dx, dy) => { rz.set-size(rz.sw + dx / 1px / stage.s, rz.sh + dy / 1px / stage.s, false); }
                        }
                        Handle {
                            x: parent.width - 8px;
                            y: parent.height / 2 - 8px;
                            cursor: ew-resize;
                            start => { rz.sw = rz.bw; rz.sh = rz.bh; }
                            drag(dx, dy) => { rz.set-size(rz.sw + dx / 1px / stage.s, rz.sh, false); }
                        }
                        Handle {
                            x: parent.width / 2 - 8px;
                            y: parent.height - 8px;
                            cursor: ns-resize;
                            start => { rz.sw = rz.bw; rz.sh = rz.bh; }
                            drag(dx, dy) => { rz.set-size(rz.sw, rz.sh + dy / 1px / stage.s, true); }
                        }
                    }
                }

                // Previous and next in the folder.
                if Viewer.mode == "" && Viewer.has-prev: IconButton {
                    x: Tokens.space-3;
                    y: (parent.height - self.height) / 2;
                    size: 44px;
                    icon-size: Tokens.icon-large;
                    on-stage: true;
                    icon: Icons.chevron-left;
                    label: "Previous (Left)";
                    background: #00000060;
                    clicked => { Viewer.prev(); }
                }
                if Viewer.mode == "" && Viewer.has-next: IconButton {
                    x: parent.width - self.width - Tokens.space-3;
                    y: (parent.height - self.height) / 2;
                    size: 44px;
                    icon-size: Tokens.icon-large;
                    on-stage: true;
                    icon: Icons.chevron-right;
                    label: "Next (Right)";
                    background: #00000060;
                    clicked => { Viewer.next(); }
                }
                // Side-by-side comparison of the pictures picked in the filmstrip.
                // The checked pictures in a grid, like Windows Photos.
                if Viewer.comparing: grid := Rectangle {
                    background: Tokens.stage;
                    property <length> cw: (self.width - 2 * Tokens.space-3) / max(1, Viewer.compare-cols);
                    property <length> ch: (self.height - 2 * Tokens.space-3) / max(1, Viewer.compare-rows);
                    for img[i] in Viewer.compare-images: Image {
                        x: Tokens.space-3 + mod(i, Viewer.compare-cols) * grid.cw;
                        y: Tokens.space-3 + floor(i / Viewer.compare-cols) * grid.ch;
                        width: grid.cw - Tokens.space-2;
                        height: grid.ch - Tokens.space-2;
                        source: img;
                        image-fit: contain;
                    }
                    Button {
                        x: parent.width - self.width - Tokens.space-3;
                        y: Tokens.space-3;
                        text: "Close comparison";
                        clicked => { Viewer.close-compare(); }
                    }
                }
                if Viewer.info-name == "" && !Viewer.loading: VerticalLayout {
                    alignment: center;
                    spacing: Tokens.space-3;
                    Text { text: "No picture open"; color: Tokens.text-on-stage; font-size: Type.heading; horizontal-alignment: center; }
                    HorizontalLayout {
                        alignment: center;
                        Button { text: "Open a picture"; kind: ButtonKind.primary; has-icon: true; icon: Icons.folder-open; clicked => { Shell.open-file(); } }
                    }
                }
                if Viewer.loading: Text {
                    text: "Opening…";
                    color: Tokens.text-on-stage;
                    font-size: Type.subheading;
                }
                if Viewer.error != "": Text {
                    text: Viewer.error;
                    color: Tokens.text-on-stage;
                    font-size: Type.subheading;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    width: parent.width - 64px;
                }
            }

        }

        // Filmstrip: the pictures in the folder. Click to open; Ctrl+click to pick several and compare them.
        if Viewer.filmstrip && !Shell.full-screen: Rectangle {
            height: 104px;
            background: Tokens.surface-sunken;
            ScrollView {
                HorizontalLayout {
                    padding: Tokens.space-2;
                    spacing: 6px;
                    alignment: start;
                    for t[i] in Viewer.thumbs: Rectangle {
                        width: 120px;
                        height: 88px;
                        border-radius: Tokens.radius-control;
                        background: thumb-ta.has-hover ? Tokens.surface-hover : #00000030;
                        border-width: t.current || t.selected ? 2px : 0px;
                        border-color: t.selected ? Tokens.accent-default : Tokens.text-primary;
                        clip: true;
                        Image {
                            source: t.image;
                            width: parent.width - 6px;
                            height: parent.height - 6px;
                            image-fit: contain;
                        }
                        thumb-ta := TouchArea {
                            mouse-cursor: pointer;
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                                    Viewer.thumb-clicked(i, e.modifiers.control || e.modifiers.shift);
                                }
                            }
                        }
                        // The check box: click it to pick or unpick this picture for the comparison grid.
                        Rectangle {
                            x: 6px;
                            y: 6px;
                            width: 18px;
                            height: 18px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: #FFFFFF;
                            background: t.selected ? Tokens.accent-fill : (check-ta.has-hover ? #000000B0 : #00000080);
                            if t.selected: Image { source: Icons.check; width: 12px; height: 12px; colorize: Tokens.text-on-accent; x: 3px; y: 3px; }
                            check-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { Viewer.thumb-clicked(i, true); }
                            }
                        }
                    }
                }
            }
        }

        // Status bar: file facts on the left, position and filmstrip in the middle, zoom on the right.
        if !Shell.full-screen: Rectangle {
            height: 34px;
            background: Tokens.surface-raised;
            Rectangle { y: 0; height: 1px; background: Tokens.border-subtle; }

            HorizontalLayout {
                x: Tokens.space-2;
                width: self.preferred-width;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: Tokens.space-2;
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.info; label: "Details (I)"; active: Viewer.show-info; clicked => { Viewer.toggle-info(); } }
                if Viewer.facts-text != "": Text { text: Viewer.facts-text; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; }
            }

            HorizontalLayout {
                x: (parent.width - self.width) / 2;
                width: self.preferred-width;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: Tokens.space-1;
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.film; label: "Filmstrip"; active: Viewer.filmstrip; clicked => { Viewer.toggle-filmstrip(); } }
                if Viewer.position != "": Text { text: Viewer.position; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; min-width: 48px; horizontal-alignment: center; }
                if Viewer.animated: HorizontalLayout {
                    spacing: Tokens.space-1;
                    Divider { height: 28px; }
                    IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.chevron-left; label: "Previous frame (,)"; clicked => { Viewer.anim-step(-1); } }
                    IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Viewer.anim-playing ? Icons.pause : Icons.play; label: Viewer.anim-playing ? "Pause (Space)" : "Play (Space)"; clicked => { Viewer.anim-toggle(); } }
                    IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.chevron-right; label: "Next frame (.)"; clicked => { Viewer.anim-step(1); } }
                    Text { text: Viewer.frame-text; color: Tokens.text-muted; font-size: Type.caption; vertical-alignment: center; }
                    IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.camera; label: "Save this frame as PNG"; clicked => { Viewer.save-frame(); } }
                }
            }

            HorizontalLayout {
                x: parent.width - self.width - Tokens.space-2;
                width: self.preferred-width;
                padding-top: 3px;
                padding-bottom: 3px;
                spacing: Tokens.space-1;
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.fit; label: "Fit to window (0)"; active: Viewer.fit; clicked => { Viewer.fit = true; Viewer.pan-x = 0; Viewer.pan-y = 0; } }
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.zoom-out; label: "Zoom out (-)"; clicked => { root.zoom-to(root.cur-scale / 1.25); } }
                Text {
                    text: round(root.cur-scale * 100) + "%";
                    color: Tokens.text-muted;
                    font-size: Type.caption;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 44px;
                }
                Rectangle {
                    width: 120px;
                    Slider {
                        width: parent.width;
                        on-stage: false;
                        value: log(root.cur-scale / 0.02, 2000);
                        changed(v) => { root.zoom-to(0.02 * pow(2000, v)); }
                        released(v) => { root.zoom-to(0.02 * pow(2000, v)); }
                    }
                }
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.zoom-in; label: "Zoom in (+)"; clicked => { root.zoom-to(root.cur-scale * 1.25); } }
                IconButton { size: 28px; icon-size: Tokens.icon-small; icon: Icons.fullscreen; label: "Full screen (F11)"; clicked => { Shell.toggle-full-screen(); } }
            }
        }
    }
}